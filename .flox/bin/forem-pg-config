#!/bin/sh
# pg_config for building the pg gem against this environment's libpq.
#
# The pg gem's extconf.rb takes include and library paths from pg_config, and
# adds -Wl,-rpath to that library dir. Without this, on Linux it can pick up
# the host's /usr/bin/pg_config, link the host's libpq, and then fail at load
# time (libgssapi_krb5.so.2 not found under Nix's loader). Used only where the
# gem compiles (aarch64-linux), via BUNDLE_BUILD__PG in the manifest hook.
if [ -x "$FLOX_ENV/bin/pg_config" ]; then exec "$FLOX_ENV/bin/pg_config" "$@"; fi
libdir=$(dirname "$(realpath "$FLOX_ENV/lib/libpq.so.5")")
case "${1:-}" in
  --includedir|--includedir-server) echo "$FLOX_ENV/include" ;;
  --libdir|--pkglibdir) echo "$libdir" ;;
  --bindir) echo "$FLOX_ENV/bin" ;;
  --version) echo "PostgreSQL 18" ;;
  *) echo "" ;;
esac
