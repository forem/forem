# Shared Kamal secrets template (safe for git — reads values from your local ENV or password manager).
# Kamal automatically loads `.kamal/secrets-common` before `.kamal/secrets` (or `.kamal/secrets.<destination>`).
#
# Required for Forem production boots:
SECRET_KEY_BASE=$SECRET_KEY_BASE

# Local postgres accessory password (required when using the built-in `postgres` accessory):
POSTGRES_PASSWORD=$POSTGRES_PASSWORD

# Database URL: uses explicit DATABASE_URL if set (e.g., Managed Postgres / RDS / custom DSN);
# otherwise automatically constructs the local `postgres` accessory URL from POSTGRES_PASSWORD.
DATABASE_URL="$(ruby -ruri -e 'u = ENV["DATABASE_URL"].to_s; p = ENV["POSTGRES_PASSWORD"].to_s; user = ENV["POSTGRES_USER"].to_s; user = "postgres" if user.empty?; db = ENV["POSTGRES_DB"].to_s; db = "forem_production" if db.empty?; s = ENV["KAMAL_SERVICE"].to_s; s = "forem" if s.empty?; d = ENV["KAMAL_DESTINATION"].to_s; if !u.empty?; puts u; elsif !p.empty? && !%w[managed cluster].include?(d); puts URI::Generic.build(scheme: "postgres" + "ql", userinfo: URI.encode_www_form_component(user) + ":" + URI.encode_www_form_component(p), host: s + "-postgres", port: 5432, path: "/" + db).to_s; end')"

# External container registry password (required only when KAMAL_REGISTRY_SERVER is not localhost:*):
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD

# Optional managed Redis URLs (used by `-d managed`, `-d cluster`, or KAMAL_EXTERNAL_REDIS=true):
# Each specialized URL falls back to REDIS_URL automatically if unset so single-Redis managed setups work with one URL.
REDIS_URL=$REDIS_URL
REDIS_SIDEKIQ_URL="$(ruby -e 'v = ENV["REDIS_SIDEKIQ_URL"].to_s; puts(v.empty? ? ENV["REDIS_URL"].to_s : v)')"
REDIS_SESSIONS_URL="$(ruby -e 'v = ENV["REDIS_SESSIONS_URL"].to_s; puts(v.empty? ? ENV["REDIS_URL"].to_s : v)')"
REDIS_RPUSH_URL="$(ruby -e 'v = ENV["REDIS_RPUSH_URL"].to_s; puts(v.empty? ? ENV["REDIS_URL"].to_s : v)')"

# Optional object storage credentials (AWS S3, DigitalOcean Spaces, Cloudflare R2, MinIO):
AWS_ID=$AWS_ID
AWS_SECRET=$AWS_SECRET

# Optional transactional email / CDN / telemetry / AI secrets:
SMTP_USER_NAME=$SMTP_USER_NAME
SMTP_PASSWORD=$SMTP_PASSWORD
SENDGRID_API_KEY=$SENDGRID_API_KEY
FASTLY_API_KEY=$FASTLY_API_KEY
RAILS_MASTER_KEY=$RAILS_MASTER_KEY
READ_ONLY_DATABASE_URL=$READ_ONLY_DATABASE_URL
GEMINI_API_KEY=$GEMINI_API_KEY
OPENAI_API_KEY=$OPENAI_API_KEY
HONEYBADGER_API_KEY=$HONEYBADGER_API_KEY
BETTERSTACK_SOURCE_TOKEN=$BETTERSTACK_SOURCE_TOKEN
BETTER_STACK_ERRORS_DSN=$BETTER_STACK_ERRORS_DSN
CERTIFICATE_PEM=$CERTIFICATE_PEM
PRIVATE_KEY_PEM=$PRIVATE_KEY_PEM
