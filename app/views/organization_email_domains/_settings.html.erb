<section id="section-email-domains" class="crayons-card crayons-card--content-rows">
  <h2><%= t("org_domain_membership.settings_title") %></h2>
  <p><%= t("org_domain_membership.settings_description") %></p>
  <p><%= t("org_domain_membership.permissions") %></p>
  <% @organization.organization_email_domains.order(:domain).each do |domain| %>
    <div class="flex flex-wrap items-center gap-3">
      <strong><%= domain.domain %></strong>
      <span><%= t("org_domain_membership.statuses.#{domain.status}") %></span>
      <% if domain.status == "approved" %>
        <span><%= t(domain.enabled? ? "org_domain_membership.enabled" : "org_domain_membership.disabled") %></span>
        <%= form_with url: organization_email_domain_path(@organization.slug, domain), method: :patch, local: true do %>
          <%= hidden_field_tag :enabled, !domain.enabled? %>
          <%= submit_tag t(domain.enabled? ? "org_domain_membership.disable" : "org_domain_membership.enable"), class: "crayons-btn crayons-btn--secondary" %>
        <% end %>
      <% end %>
      <% unless domain.status == "revoked" %>
        <%= button_to t("org_domain_membership.remove"), organization_email_domain_path(@organization.slug, domain), method: :delete, class: "crayons-btn crayons-btn--danger" %>
      <% end %>
    </div>
  <% end %>
  <%= form_with url: organization_email_domains_path(@organization.slug), method: :post, local: true, class: "grid gap-3" do %>
    <%= label_tag :domain, t("org_domain_membership.domain"), class: "crayons-field__label" %>
    <%= text_field_tag :domain, nil, required: true, maxlength: 253, placeholder: "foobar.com", autocomplete: "off", class: "crayons-textfield" %>
    <%= submit_tag t("org_domain_membership.request_approval"), class: "crayons-btn" %>
  <% end %>
</section>
