<% page_heading = @page.embed_html? ? t("views.organization_settings.pages.edit_embed_page") : t("views.organization_settings.pages.edit_page") %>
<% title page_heading %>

<div class="crayons-layout crayons-layout--limited-l pt-7">
  <div class="flex items-center justify-between mb-6">
    <h1 class="crayons-title"><%= page_heading %></h1>
    <%= link_to "&larr; #{t("views.organization_settings.pages.back_to_pages")}".html_safe, organization_pages_path(@organization.slug), class: "crayons-btn crayons-btn--secondary" %>
  </div>

  <% if @page.embed_html? %>
    <%= render "embed_form", url: update_organization_page_path(@organization.slug, @page), method: :patch, is_new: false %>
  <% else %>
    <%= render "form", url: update_organization_page_path(@organization.slug, @page), method: :patch, is_new: false %>
  <% end %>
</div>
