<%
  current_suffix = @page.slug&.sub(%r{\A[^/]+/embed/}, "")
  forem_host = Addressable::URI.parse(URL.url).host || request.host
%>

<%= form_for @page, url: url, method: method, html: { class: "grid gap-6" } do |f| %>
  <%= f.hidden_field :template, value: Page::EMBED_HTML_TEMPLATE %>

  <% if @page.errors.any? %>
    <div class="crayons-notice crayons-notice--danger">
      <% @page.errors.full_messages.each do |msg| %>
        <p><%= msg %></p>
      <% end %>
    </div>
  <% end %>

  <div class="crayons-card crayons-card--content-rows">
    <h2><%= is_new ? t("views.organization_settings.pages.new_embed_page") : t("views.organization_settings.pages.edit_embed_page") %></h2>

    <div class="crayons-notice crayons-notice--info">
      <p class="fw-medium mb-1"><%= t("views.organization_settings.pages.embed_sandbox_notice_title") %></p>
      <p class="fs-s color-base-70 mb-0"><%= t("views.organization_settings.pages.embed_sandbox_notice_body") %></p>
    </div>

    <div class="crayons-field">
      <%= f.label :title, t("views.organization_settings.pages.title"), class: "crayons-field__label" %>
      <%= f.text_field :title, class: "crayons-textfield", required: true, placeholder: "e.g. Interactive Pricing Calculator" %>
    </div>

    <div class="crayons-field">
      <%= label_tag "page[slug_suffix]", t("views.organization_settings.pages.slug"), class: "crayons-field__label" %>
      <div class="flex items-center">
        <span class="fs-base color-base-60 mr-2"><%= forem_host %>/<%= @organization.slug %>/embed/</span>
        <%= text_field_tag "page[slug_suffix]", current_suffix, class: "crayons-textfield", required: true, pattern: "[a-z0-9\\-]+", placeholder: "e.g. pricing-calculator" %>
      </div>
      <p class="crayons-field__description"><%= t("views.organization_settings.pages.embed_slug_help") %></p>
    </div>

    <% if !is_new && current_suffix.present? %>
      <div class="crayons-field">
        <span class="crayons-field__label"><%= t("views.organization_settings.pages.embed_usage_label") %></span>
        <code class="crayons-code fs-s">{% embed <%= URL.url("/#{@organization.slug}/embed/#{current_suffix}") %> %}</code>
      </div>
    <% end %>

    <div class="crayons-field">
      <%= f.label :description, t("views.organization_settings.pages.description"), class: "crayons-field__label" %>
      <%= f.text_field :description, class: "crayons-textfield", placeholder: t("views.organization_settings.pages.description_placeholder") %>
    </div>

    <div class="crayons-field" id="org-embed-html-editor">
      <div class="flex items-center justify-between mb-2">
        <%= f.label :body_html, t("views.organization_settings.pages.embed_content_label"), class: "crayons-field__label mb-0" %>
        <div class="flex gap-1" role="tablist">
          <button type="button"
                  id="org-embed-tab-edit"
                  class="crayons-btn crayons-btn--secondary crayons-btn--s"
                  aria-selected="true">
            <%= t("views.organization_settings.pages.edit") %>
          </button>
          <button type="button"
                  id="org-embed-tab-preview"
                  class="crayons-btn crayons-btn--ghost crayons-btn--s"
                  aria-selected="false">
            <%= t("views.organization_settings.page.preview") %>
          </button>
        </div>
      </div>

      <div id="org-embed-edit-pane">
        <%= f.text_area :body_html,
                        id: "org_embed_body_html",
                        class: "crayons-textfield ff-monospace fs-base",
                        style: "min-height: 400px;",
                        required: true,
                        placeholder: t("views.organization_settings.pages.embed_content_placeholder") %>
      </div>

      <div id="org-embed-preview-pane" class="hidden">
        <iframe id="org-embed-preview-frame"
                title="<%= t("views.organization_settings.page.preview") %>"
                width="100%"
                height="480"
                frameborder="0"
                sandbox="<%= OrganizationEmbedsController::SANDBOX_DIRECTIVE %>"
                credentialless
                referrerpolicy="no-referrer"
                allow="<%= PageTag::IFRAME_ALLOW_POLICY %>"
                style="width: 100%; border: 1px solid var(--card-border, #e1e5e9); border-radius: var(--radius-auto, 6px); background: #fff;">
        </iframe>
      </div>
    </div>

    <div class="flex gap-2 mt-4">
      <button type="submit" class="crayons-btn"><%= t("views.organization_settings.page.save") %></button>
      <%= link_to t("views.organization_settings.pages.cancel"), organization_pages_path(@organization.slug), class: "crayons-btn crayons-btn--secondary" %>
    </div>
  </div>
<% end %>

<script>
  (function() {
    var root = document.getElementById("org-embed-html-editor");
    if (!root || root.dataset.initialized === "true") return;
    root.dataset.initialized = "true";

    var editBtn = document.getElementById("org-embed-tab-edit");
    var previewBtn = document.getElementById("org-embed-tab-preview");
    var editPane = document.getElementById("org-embed-edit-pane");
    var previewPane = document.getElementById("org-embed-preview-pane");
    var textarea = document.getElementById("org_embed_body_html");
    var frame = document.getElementById("org-embed-preview-frame");
    if (!editBtn || !previewBtn || !editPane || !previewPane || !textarea || !frame) return;

    editBtn.addEventListener("click", function() {
      previewPane.classList.add("hidden");
      editPane.classList.remove("hidden");
      editBtn.className = "crayons-btn crayons-btn--secondary crayons-btn--s";
      previewBtn.className = "crayons-btn crayons-btn--ghost crayons-btn--s";
      editBtn.setAttribute("aria-selected", "true");
      previewBtn.setAttribute("aria-selected", "false");
    });

    previewBtn.addEventListener("click", function() {
      frame.srcdoc = textarea.value || "";
      editPane.classList.add("hidden");
      previewPane.classList.remove("hidden");
      previewBtn.className = "crayons-btn crayons-btn--secondary crayons-btn--s";
      editBtn.className = "crayons-btn crayons-btn--ghost crayons-btn--s";
      previewBtn.setAttribute("aria-selected", "true");
      editBtn.setAttribute("aria-selected", "false");
    });
  })();
</script>
