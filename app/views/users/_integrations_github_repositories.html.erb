<% if show_integration %>
  <div class="crayons-card crayons-card--content-rows" id="github">
    <header>
      <h2 class="crayons-subtitle-1">
        <%= t("views.settings.extensions.github.heading") %>
      </h2>
      <p class="color-base-70">
        <%= t("views.settings.extensions.github.desc1") %>
      </p>
      <p class="color-base-70">
        <em><%= t("views.settings.extensions.github.desc2") %></em>
      </p>
    </header>

    <h3 class="crayons-subtitle-2"><%= t("views.settings.extensions.github.organizations_heading") %></h3>
    <p class="color-base-70">
      <%= t("views.settings.extensions.github.organizations_desc", max: Users::Setting::MAX_GITHUB_ORGANIZATIONS) %>
    </p>

    <div id="github-repos-container"
         data-organizations="<%= current_user.setting.github_organizations.to_json %>"
         data-max-organizations="<%= Users::Setting::MAX_GITHUB_ORGANIZATIONS %>">
      <div class="github-repos loading-repos">
      </div>
    </div>

    <%= javascript_include_tag "githubRepos", defer: true %>
  </div>
<% end %>
