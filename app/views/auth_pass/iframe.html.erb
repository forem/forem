<!-- In app/views/auth/iframe.html.erb -->
<script>
  (function() {
    var data = {
      authenticated: <%= @token.present? ? 'true' : 'false' %>,
      token: '<%= @token %>'
    };

    // Send the message to the parent window
    window.parent.postMessage(data, <%= raw ERB::Util.json_escape((@target_origin || request.base_url).to_json) %>);
  })();
</script>