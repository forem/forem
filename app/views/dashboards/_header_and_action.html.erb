<% dashboard_state = local_assigns[:dashboard_state] || params[:action] %>
<header class="crayons-page-header block">
    <%= render "flag_appeals/suspended_notice" %>
    <h1 class="crayons-title"><%= page_title %></h1>
    <div id="dashboard-mobile-sidebar-wrapper">
      <div class="block m:hidden pt-3">
        <select id="mobile_nav_dashboard" class="crayons-select">
          <option value="/dashboard" <%= "selected" if dashboard_state == "show" && (params[:which] == "organization" || params[:which].blank?) %>><%= t("views.dashboard.actions.posts") %></option>
          <% if current_user %>
            <option value="<%= user_series_path(current_user.username) %>" <%= "selected" if dashboard_state == "series" %>><%= t("views.dashboard.actions.series") %></option>
          <% end %>
          <option value="/dashboard/user_followers" <%= "selected" if dashboard_state == "followers" %>><%= t("views.dashboard.actions.followers") %></option>
          <option value="/dashboard/following_tags" <%= "selected" if dashboard_state == "following_tags" %>><%= t("views.dashboard.actions.following_tags") %></option>
          <option value="/dashboard/following_users" <%= "selected" if dashboard_state == "following_users" %>><%= t("views.dashboard.actions.following_users") %></option>
          <option value="/dashboard/following_organizations" <%= "selected" if dashboard_state == "following_organizations" %>><%= t("views.dashboard.actions.following_orgs") %></option>
          <option value="<%= dashboard_analytics_path %>" <%= "selected" if dashboard_state == "analytics" %>><%= t("views.dashboard.actions.analytics") %></option>
          <option value="/dashboard/feed_imports" <%= "selected" if dashboard_state == "feed_imports" %>><%= t("views.dashboard.actions.feed_imports") %></option>
          <option value="/dashboard/hidden_tags" <%= "selected" if dashboard_state == "hidden_tags" %>><%= t("views.dashboard.actions.hidden_tags") %></option>
          <option value="<%= agent_sessions_path %>" <%= "selected" if dashboard_state == "agent_sessions" %>><%= t("views.dashboard.actions.agent_sessions") %></option>
          <% if current_user&.can_manage_embed_pages? %>
            <option value="<%= dashboard_embed_pages_path %>" <%= "selected" if dashboard_state == "embed_pages" %>><%= t("views.dashboard.actions.embed_pages") %></option>
          <% end %>
        </select>
      </div>
    </div>
    <%= render "dashboards/analytics" if dashboard_state == "show" %>
  </header>

  <div class="crayons-layout__sidebar-left">
    <div id="dashboard-main-sidebar-wrapper">
      <nav class="hidden m:block" aria-label="Dashboards">
        <ul class="list-none p-0">
          <li>
            <a class="crayons-link crayons-link--block <%= "crayons-link--current" if dashboard_state == "show" && (params[:which] == "organization" || params[:which].blank?) %>" href="/dashboard">
              <%= t("views.dashboard.actions.posts") %>
            </a>
          </li>
      
          <li>
            <a class="crayons-link crayons-link--block <%= "crayons-link--current" if dashboard_state == "series" %>" href="<%= user_series_path(current_user.username) %>">
              <%= t("views.dashboard.actions.series") %>
            </a>
          </li>
      
          <li>
            <a class="crayons-link crayons-link--block <%= "crayons-link--current" if dashboard_state == "followers" %>" href="/dashboard/user_followers">
              <%= t("views.dashboard.actions.followers") %>
            </a>
          </li>
      
          <li>
            <a class="crayons-link crayons-link--block js-following-tags-link <%= "crayons-link--current" if dashboard_state == "following_tags" %>" href="/dashboard/following_tags">
              <%= t("views.dashboard.actions.following_tags") %>
            </a>
          </li>
      
          <li>
            <a class="crayons-link crayons-link--block <%= "crayons-link--current" if dashboard_state == "following_users" %>" href="/dashboard/following_users">
              <%= t("views.dashboard.actions.following_users") %>
            </a>
          </li>
      
          <li>
            <a class="crayons-link crayons-link--block <%= "crayons-link--current" if dashboard_state == "following_organizations" %>" href="/dashboard/following_organizations">
              <%= t("views.dashboard.actions.following_orgs") %>
            </a>
          </li>
      

          <li>
            <a class="crayons-link crayons-link--block" href="/dashboard/analytics">
              <%= t("views.dashboard.actions.analytics") %>
            </a>
          </li>
      
          <li>
            <a class="crayons-link crayons-link--block <%= "crayons-link--current" if dashboard_state == "feed_imports" %>" href="/dashboard/feed_imports">
              <%= t("views.dashboard.actions.feed_imports") %>
            </a>
          </li>

          <li>
            <a class="crayons-link crayons-link--block js-hidden-tags-link <%= "crayons-link--current" if dashboard_state == "hidden_tags" %>" href="/dashboard/hidden_tags">
              <%= t("views.dashboard.actions.hidden_tags") %>
            </a>
          </li>

          <li>
            <a class="crayons-link crayons-link--block" href="<%= agent_sessions_path %>">
              <%= t("views.dashboard.actions.agent_sessions") %>
            </a>
          </li>

          <% if current_user&.can_manage_embed_pages? %>
            <li>
              <a class="crayons-link crayons-link--block <%= "crayons-link--current" if dashboard_state == "embed_pages" %>" href="<%= dashboard_embed_pages_path %>">
                <%= t("views.dashboard.actions.embed_pages") %>
              </a>
            </li>
          <% end %>
        </ul>
      </nav>
    </div>
  </div>

  <script>
    (() => {
      const mainWrapper = document.getElementById('dashboard-main-sidebar-wrapper');
      const mobileWrapper = document.getElementById('dashboard-mobile-sidebar-wrapper');

      fetch('/dashboard/sidebar?state=<%= dashboard_state %>&which=<%= params[:which] %>', {
        credentials: 'same-origin'
      })
        .then(response => (response.ok && !response.redirected ? response.text() : ''))
        .then(html => {
          if (mainWrapper && document.contains(mainWrapper) && html && html.includes('main-dashboard-side-nav')) {
            mainWrapper.innerHTML = html;
          }
        });

      function bindMobileNav() {
        const navtrigger = document.getElementById('mobile_nav_dashboard');
        if (navtrigger && !navtrigger.dataset.bound) {
          navtrigger.dataset.bound = 'true';
          navtrigger.addEventListener('change', (event) => {
            const url = event.target.value;
            if (typeof InstantClick !== 'undefined' && InstantClick.display) {
              InstantClick.preload(url);
              InstantClick.display(url);
            }
          });
        }
      }

      bindMobileNav();

      window.fetch('/dashboard/sidebar?type_of=mobile&state=<%= dashboard_state %>&which=<%= params[:which] %>', {
        credentials: 'same-origin'
      })
        .then(response => (response.ok && !response.redirected ? response.text() : ''))
        .then(html => {
          if (mobileWrapper && document.contains(mobileWrapper) && html && html.includes('mobile_nav_dashboard')) {
            mobileWrapper.innerHTML = html;
            bindMobileNav();
          }
        });
    })();
  </script>
