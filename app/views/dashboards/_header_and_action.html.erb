<header class="crayons-page-header block">
    <%= render "flag_appeals/suspended_notice" %>
    <h1 class="crayons-title"><%= page_title %></h1>
    <div id="dashboard-mobile-sidebar-wrapper">
      <div class="block m:hidden pt-3">
        <select id="mobile_nav_dashboard" class="crayons-select">
          <option value="/dashboard" <%= "selected" if params[:action] == "show" && (params[:which] == "organization" || params[:which].blank?) %>><%= t("views.dashboard.actions.posts") %></option>
          <% if current_user %>
            <option value="<%= user_series_path(current_user.username) %>" <%= "selected" if params[:action] == "series" %>><%= t("views.dashboard.actions.series") %></option>
          <% end %>
          <option value="/dashboard/user_followers" <%= "selected" if params[:action] == "followers" %>><%= t("views.dashboard.actions.followers") %></option>
          <option value="/dashboard/following_tags" <%= "selected" if params[:action] == "following_tags" %>><%= t("views.dashboard.actions.following_tags") %></option>
          <option value="/dashboard/following_users" <%= "selected" if params[:action] == "following_users" %>><%= t("views.dashboard.actions.following_users") %></option>
          <option value="/dashboard/following_organizations" <%= "selected" if params[:action] == "following_organizations" %>><%= t("views.dashboard.actions.following_orgs") %></option>
          <option value="<%= dashboard_analytics_path %>" <%= "selected" if params[:action] == "analytics" %>><%= t("views.dashboard.actions.analytics") %></option>
          <option value="/dashboard/feed_imports" <%= "selected" if params[:action] == "feed_imports" %>><%= t("views.dashboard.actions.feed_imports") %></option>
          <option value="/dashboard/hidden_tags" <%= "selected" if params[:action] == "hidden_tags" %>><%= t("views.dashboard.actions.hidden_tags") %></option>
          <option value="<%= agent_sessions_path %>" <%= "selected" if params[:action] == "agent_sessions" %>><%= t("views.dashboard.actions.agent_sessions") %></option>
        </select>
      </div>
    </div>
    <%= render "analytics" if params[:action] == "show" %>
  </header>

  <div class="crayons-layout__sidebar-left">
    <div id="dashboard-main-sidebar-wrapper">
      <nav class="hidden m:block" aria-label="Dashboards">
        <ul class="list-none p-0">
          <li>
            <a class="crayons-link crayons-link--block <%= "crayons-link--current" if params[:action] == "show" && (params[:which] == "organization" || params[:which].blank?) %>" href="/dashboard">
              <%= t("views.dashboard.actions.posts") %>
            </a>
          </li>
      
          <li>
            <a class="crayons-link crayons-link--block <%= "crayons-link--current" if params[:action] == "series" %>" href="<%= user_series_path(current_user.username) %>">
              <%= t("views.dashboard.actions.series") %>
            </a>
          </li>
      
          <li>
            <a class="crayons-link crayons-link--block <%= "crayons-link--current" if params[:action] == "followers" %>" href="/dashboard/user_followers">
              <%= t("views.dashboard.actions.followers") %>
            </a>
          </li>
      
          <li>
            <a class="crayons-link crayons-link--block js-following-tags-link <%= "crayons-link--current" if params[:action] == "following_tags" %>" href="/dashboard/following_tags">
              <%= t("views.dashboard.actions.following_tags") %>
            </a>
          </li>
      
          <li>
            <a class="crayons-link crayons-link--block <%= "crayons-link--current" if params[:action] == "following_users" %>" href="/dashboard/following_users">
              <%= t("views.dashboard.actions.following_users") %>
            </a>
          </li>
      
          <li>
            <a class="crayons-link crayons-link--block <%= "crayons-link--current" if params[:action] == "following_organizations" %>" href="/dashboard/following_organizations">
              <%= t("views.dashboard.actions.following_orgs") %>
            </a>
          </li>
      

          <li>
            <a class="crayons-link crayons-link--block" href="/dashboard/analytics">
              <%= t("views.dashboard.actions.analytics") %>
            </a>
          </li>
      
          <li>
            <a class="crayons-link crayons-link--block <%= "crayons-link--current" if params[:action] == "feed_imports" %>" href="/dashboard/feed_imports">
              <%= t("views.dashboard.actions.feed_imports") %>
            </a>
          </li>

          <li>
            <a class="crayons-link crayons-link--block js-hidden-tags-link <%= "crayons-link--current" if params[:action] == "hidden_tags" %>" href="/dashboard/hidden_tags">
              <%= t("views.dashboard.actions.hidden_tags") %>
            </a>
          </li>

          <li>
            <a class="crayons-link crayons-link--block" href="<%= agent_sessions_path %>">
              <%= t("views.dashboard.actions.agent_sessions") %>
            </a>
          </li>
        </ul>
      </nav>
    </div>
  </div>

  <script>
    fetch('/dashboard/sidebar?state=<%= params[:action] %>&which=<%= params[:which] %>', {
      credentials: 'same-origin'
    })
      .then(response => (response.ok && !response.redirected ? response.text() : ''))
      .then(html => {
        if (html && html.includes('main-dashboard-side-nav')) {
          document.getElementById('dashboard-main-sidebar-wrapper').innerHTML = html;
        }
      });

    function bindMobileNav() {
      let navtrigger = document.getElementById('mobile_nav_dashboard');
      if (navtrigger && !navtrigger.dataset.bound) {
        navtrigger.dataset.bound = 'true';
        navtrigger.addEventListener('change', (event) => {
          let url = event.target.value;
          if (typeof InstantClick !== 'undefined' && InstantClick.display) {
            InstantClick.preload(url);
            InstantClick.display(url);
          } else {
            window.location.href = url;
          }
        });
      }
    }

    bindMobileNav();

    window.fetch('/dashboard/sidebar?type_of=mobile&state=<%= params[:action] %>&which=<%= params[:which] %>', {
      credentials: 'same-origin'
    })
      .then(response => (response.ok && !response.redirected ? response.text() : ''))
      .then(html => {
        if (html && html.includes('mobile_nav_dashboard')) {
          document.getElementById('dashboard-mobile-sidebar-wrapper').innerHTML = html;
          bindMobileNav();
        }
      });
  </script>
