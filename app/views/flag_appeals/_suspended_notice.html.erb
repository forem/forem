<% if current_user&.actively_suspended? && (@user.nil? || @user.id == current_user.id) && params[:which] != "organization" %>
  <div class="crayons-notice crayons-notice--danger mb-6" role="alert" data-testid="suspended-account-notice">
    <h3 class="mb-2"><%= t("views.flag_appeals.suspended_notice.heading") %></h3>
    <p class="mb-2"><%= t("views.flag_appeals.suspended_notice.description") %></p>
    <p class="mb-0">
      <%= t("views.flag_appeals.suspended_notice.contact_or_appeal_html",
            contact: contact_link,
            appeal_link: link_to(t("views.flag_appeals.suspended_notice.appeal_link"), appeal_path, class: "c-link font-bold text-underline")) %>
    </p>
  </div>
<% end %>
