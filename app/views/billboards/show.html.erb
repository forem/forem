<% if @billboard %>
  <% hidden_by_default = BillboardPlacementAreaConfig.hidden_by_default_for(@billboard.placement_area) %>
  <% cache "billboard-#{@billboard.id}-#{@billboard.content_updated_at}#{'-hidden' if hidden_by_default}", expires_in: 12.hours do %>
    <%= render partial: "shared/billboard", locals: { billboard: @billboard, data_context_type: BillboardEvent::CONTEXT_TYPE_ARTICLE, hidden_by_default: hidden_by_default } %>
  <% end %>
<% end %>
