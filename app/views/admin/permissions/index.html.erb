<% content_for :h1, t("views.admin.permissions.title") %>

<div class="admin-permissions">
  <header class="admin-permissions-header">
    <div>
      <h1 class="crayons-title admin-permissions-header__title"><%= t("views.admin.permissions.title") %></h1>
      <p class="admin-permissions-header__subtitle"><%= t("views.admin.permissions.subtitle") %></p>
    </div>
  </header>

  <%= render "grant_form",
             role_options: grantable_role_options_grouped(is_super_admin: @is_super_admin),
             sub_permissions_config: sub_permissions_ui_config %>

  <section class="crayons-card" aria-label="<%= t("views.admin.permissions.title") %>">
    <%= render "toolbar" %>

    <% if @users.any? %>
      <div class="admin-permissions-table-wrap">
        <table class="admin-permissions-table">
          <thead>
            <tr>
              <th scope="col" class="admin-permissions-table__member-col"><%= t("views.admin.permissions.table.member") %></th>
              <th scope="col"><%= t("views.admin.permissions.table.roles") %></th>
              <th scope="col" class="admin-permissions-table__actions-col"><%= t("views.admin.permissions.table.actions") %></th>
            </tr>
          </thead>
          <tbody>
            <% @users.each do |user| %>
              <%= render "member_row", user: user %>
            <% end %>
          </tbody>
        </table>
      </div>

      <% if @users.total_pages > 1 %>
        <div class="admin-permissions-pagination">
          <%= paginate @users %>
        </div>
      <% end %>
    <% else %>
      <div class="admin-permissions-empty">
        <h2 class="admin-permissions-empty__title"><%= t("views.admin.permissions.table.empty_title") %></h2>
        <p class="admin-permissions-empty__description">
          <%= @filters_active ? t("views.admin.permissions.table.empty_filtered") : t("views.admin.permissions.table.empty_default") %>
        </p>
        <% if @filters_active %>
          <%= link_to t("views.admin.permissions.filters.clear"), admin_permissions_path, class: "crayons-btn crayons-btn--secondary crayons-btn--s" %>
        <% end %>
      </div>
    <% end %>
  </section>
</div>
