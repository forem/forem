<% elsif @current_tab == 'collections' %>
  <section class="crayons-card p-3 s:p-4 m:p-7">
    <%= render "admin/users/show/collections/index" %>
  </section>
<% elsif @current_tab == 'follows' %>
  <section class="crayons-card p-3 s:p-4 m:p-7">
