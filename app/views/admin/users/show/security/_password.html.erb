<h2 class="crayons-subtitle-1 mb-2"><%= t("views.admin.users.password.title") %></h2>
<p class="color-base-70 mb-4"><%= t("views.admin.users.password.description") %></p>

<%= form_with model: @user, url: update_password_admin_user_path(@user), method: :patch, local: true, class: "mb-6" do |f| %>
  <div class="grid gap-4">
    <div>
      <%= f.label :password, t("views.admin.users.password.new_password"), class: "crayons-field__label" %>
      <%= f.password_field :password, class: "crayons-textfield", autocomplete: "new-password", required: true %>
    </div>
    <div>
      <%= f.label :password_confirmation, t("views.admin.users.password.password_confirmation"), class: "crayons-field__label" %>
      <%= f.password_field :password_confirmation, class: "crayons-textfield", autocomplete: "new-password", required: true %>
    </div>
    <div>
      <%= f.submit t("views.admin.users.password.submit"), class: "c-cta" %>
    </div>
  </div>
<% end %>

<hr class="my-5">

<h3 class="crayons-subtitle-2 mb-2"><%= t("views.admin.users.password.reset_title") %></h3>
<p class="color-base-70 mb-4"><%= t("views.admin.users.password.reset_description") %></p>

<%= button_to t("views.admin.users.password.reset_submit"),
              send_password_reset_admin_user_path(@user),
              method: :post,
              class: "c-btn" %>
