<h1 class="crayons-title mb-4">
  <%= Email.replace_merge_tags(@email.subject, current_user) %> [<%= @email.status %>]
  <% unless ForemInstance.customerio_email_cutover? %>
    <%= link_to "Edit", edit_admin_email_path(@email), class: "crayons-btn ml-3" %>
  <% end %>
</h1>

<% if ForemInstance.customerio_email_cutover? %>
  <div class="crayons-notice crayons-notice--warning mb-4" role="alert">
    <%= t("admin.emails.customerio_cutover_notice") %>
  </div>
<% end %>
<div class="crayons-card p-6 mb-4">
  <p>Type: <%= @email.type_of %></p>
  <p>
    Audience Target:
    <% if @email.audience_segment.present? %>
      <%= link_to @email.audience_segment.display_name, admin_audience_segment_path(@email.audience_segment), class: "crayons-link font-medium" %>
      <span class="text-xs text-gray-500">(<%= pluralize(@email.audience_segment.user_count, "user") %>)</span>
    <% elsif @email.user_query.present? %>
      <%= link_to @email.user_query.name, admin_user_query_path(@email.user_query), class: "crayons-link font-medium" %>
    <% elsif @email.event.present? %>
      <%= @email.event.title %>
    <% else %>
      <span class="crayons-tag crayons-tag--warning">All Users (Broadcast)</span>
    <% end %>
  </p>
  <% if @email.variables.present? %>
    <p>Variables: <code><%= @email.variables %></code></p>
  <% end %>
  <p><%= t("admin.emails.override_footer_label") %> <%= @email.override_footer_html? ? t("admin.emails.status_yes") : t("admin.emails.status_no") %></p>
  <% if @email.override_footer_html? && @email.custom_footer_html.present? %>
    <p><%= t("admin.emails.custom_footer_label") %> <code><%= @email.custom_footer_html %></code></p>
  <% end %>
</div>
<div class="crayons-card p-6 mb-4">
  <h2 class="crayons-title mb-4">Rendered Email</h2>
  <div class="mb-4">
    <%= Email.replace_merge_tags(@email.body, current_user).html_safe %>
  </div>
  <% footer = @email.footer_html_to_render %>
  <% if footer.present? %>
    <hr class="my-4" />
    <div class="text-styles">
      <%= sanitize(Email.replace_merge_tags(footer, current_user), tags: EmailSafeHtmlValidator::ALLOWED_TAGS, attributes: EmailSafeHtmlValidator::ALLOWED_ATTRIBUTES) %>
    </div>
  <% end %>
</div>

<div class="crayons-card p-6">
  <h2 class="crayons-title mb-4">Raw HTML</h2>
  <div class="mb-4">
    <%= @email.subject %>
  </div>
  <pre>
    <%= @email.body %>
  </pre>
</div>

<% unless ForemInstance.customerio_email_cutover? %>
  <div class="crayons-card p-6 mb-4 mt-4">
    <h2 class="crayons-title mb-4">Send test email</h2>
    <%= form_with(model: [:admin, @email], local: true) do |f| %>
      <div class="crayons-field">
        <%= f.label :test_email_addresses, class: "crayons-field__label" %>
        <%= f.text_field :test_email_addresses, class: "crayons-textfield", placeholder: "email@address.com, email2@other.com" %>
      </div>
      <div class="crayons-field mt-2">
        <%= f.submit "Send Test Email", class: "crayons-btn crayons-btn--primary" %>
      </div>
    <% end %>
  </div>
<% end %>
