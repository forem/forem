<div class="grid gap-6">
  <div class="crayons-card p-6 flex flex-col gap-6">
    <div class="flex items-center justify-between border-b border-border pb-4">
      <div>
        <h1 class="crayons-title text-2xl">Flag Appeal #<%= @appeal.id %></h1>
        <span class="fs-xs color-base-60">Submitted <%= time_ago_in_words(@appeal.created_at) %> ago</span>
      </div>

      <% status_indicator = case @appeal.status
                            when "approved" then "c-indicator--success"
                            when "rejected" then "c-indicator--danger"
                            else "c-indicator--info"
                            end %>
      <span class="c-indicator <%= status_indicator %> text-sm font-bold uppercase">
        <%= @appeal.status.humanize %>
      </span>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div class="crayons-card crayons-card--secondary p-4 flex flex-col gap-2">
        <h3 class="fs-xs font-bold uppercase color-base-60">Appealing User</h3>
        <div>
          <%= link_to @appeal.user.name, admin_user_path(@appeal.user), class: "c-link text-lg font-bold" %>
          <span class="block fs-sm color-base-60">@<%= @appeal.user.username %> (ID: <%= @appeal.user.id %>)</span>
        </div>
        <div>
          <% role_badge = @appeal.user.spam_or_suspended? ? "c-indicator--danger" : "c-indicator--success" %>
          <span class="c-indicator <%= role_badge %> fs-xs">
            <%= @appeal.user.spam_or_suspended? ? "Suspended / Spam Flagged" : "Active" %>
          </span>
        </div>
      </div>

      <div class="crayons-card crayons-card--secondary p-4 flex flex-col gap-2">
        <h3 class="fs-xs font-bold uppercase color-base-60">Target Entity</h3>
        <div class="text-lg font-bold">
          <span class="c-indicator c-indicator--info"><%= @appeal.appealable_type %></span>
          <span>#<%= @appeal.appealable_id %></span>
        </div>
        <p class="fs-xs color-base-60">Restricted item tied to this appeal record</p>
      </div>
    </div>

    <div class="crayons-card p-4 flex flex-col gap-2">
      <h3 class="fs-sm font-bold color-base-80">User's Appeal Statement</h3>
      <div class="p-3 bg-base-5 rounded border border-border-tertiary whitespace-pre-wrap fs-regular">
        <%= @appeal.reason %>
      </div>
    </div>

    <div class="crayons-card p-5 flex flex-col gap-3 border border-accent-brand bg-accent-brand-tint">
      <div class="flex items-center justify-between">
        <h3 class="crayons-title text-lg flex items-center gap-2">
          <%= crayons_icon_tag("robot", class: "w-5 h-5") %>
          AI Re-Assessment Summary
        </h3>

        <% rec_class = case @appeal.ai_recommendation
                        when "auto_unflag" then "c-indicator--success"
                        when "confirm_flag" then "c-indicator--danger"
                        else "c-indicator--warning"
                        end %>
        <span class="c-indicator <%= rec_class %> font-bold">
          Recommendation: <%= @appeal.ai_recommendation.humanize %>
        </span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
        <div>
          <span class="fs-xs color-base-60 block">Confidence Score</span>
          <strong class="text-lg"><%= @appeal.ai_confidence_score ? "#{(@appeal.ai_confidence_score * 100).round}%" : "N/A" %></strong>
        </div>

        <div class="md:col-span-2">
          <span class="fs-xs color-base-60 block">AI Evaluation Assessment</span>
          <p class="fs-sm mt-1"><%= @appeal.ai_summary.presence || "Pending AI background evaluation..." %></p>
        </div>
      </div>
    </div>

    <% if @appeal.open? || @appeal.ai_reviewed? %>
      <% approve_confirm = if @appeal.appealable_type == "Article"
                             "This will approve Appeal ##{@appeal.id}, reinstate @#{@appeal.user.username}'s account (removing suspended/spam status), clear automod flags on Article ##{@appeal.appealable_id}, and remove spam mascot reactions. Are you sure you want to proceed?"
                           else
                             "This will approve Appeal ##{@appeal.id} and reinstate @#{@appeal.user.username}'s account (removing suspended/spam status). Are you sure you want to proceed?"
                           end %>
      <% reject_confirm = "This will reject Appeal ##{@appeal.id} and maintain all active restrictions on @#{@appeal.user.username}'s account. Are you sure you want to proceed?" %>

      <div class="flex items-center gap-4 pt-4 border-t border-border">
        <%= button_to "Approve & Unflag", admin_flag_appeal_path(@appeal, resolution: "approve"), method: :patch, data: { confirm: approve_confirm }, form: { data: { confirm: approve_confirm } }, class: "crayons-btn crayons-btn--primary" %>
        <%= button_to "Reject Appeal", admin_flag_appeal_path(@appeal, resolution: "reject"), method: :patch, data: { confirm: reject_confirm }, form: { data: { confirm: reject_confirm } }, class: "crayons-btn crayons-btn--secondary" %>
      </div>
    <% else %>
      <div class="pt-4 border-t border-border color-base-60 fs-sm">
        <p>Resolved by: <strong><%= @appeal.resolved_by&.name || "System" %></strong> on <%= @appeal.updated_at.strftime("%B %d, %Y %H:%M") %></p>
      </div>
    <% end %>

    <div class="pt-2">
      <%= link_to "← Back to Appeals Queue", admin_flag_appeals_path, class: "crayons-btn crayons-btn--outlined" %>
    </div>
  </div>
</div>
