<div class="crayons-card p-4">
  <div class="flex flex-wrap items-center justify-between gap-4 mb-4 pb-3 border-b border-border">
    <h1 class="crayons-title text-xl">Flag Appeals Queue</h1>

    <div class="flex items-center gap-3">
      <div class="crayons-navigation border-0 m-0">
        <div class="crayons-navigation__content">
          <%= link_to "Pending", admin_flag_appeals_path(status: "pending"), class: "crayons-navigation__item #{@status == 'pending' ? 'crayons-navigation__item--current' : ''}" %>
          <%= link_to "Approved", admin_flag_appeals_path(status: "approved"), class: "crayons-navigation__item #{@status == 'approved' ? 'crayons-navigation__item--current' : ''}" %>
          <%= link_to "Rejected", admin_flag_appeals_path(status: "rejected"), class: "crayons-navigation__item #{@status == 'rejected' ? 'crayons-navigation__item--current' : ''}" %>
        </div>
      </div>

      <% if @flag_appeals.any? %>
        <button id="toggleAllAppeals" class="crayons-btn crayons-btn--secondary crayons-btn--s">Expand All</button>
      <% end %>
    </div>
  </div>

  <% if @flag_appeals.any? %>
    <div class="grid gap-3">
      <% @flag_appeals.each do |appeal| %>
        <%= render "flag_appeal", appeal: appeal %>
      <% end %>
    </div>

    <div class="my-4 flex justify-center">
      <%= paginate @flag_appeals %>
    </div>
  <% else %>
    <p class="color-base-60 p-4 text-center">No flag appeals found matching this status.</p>
  <% end %>
</div>

<script>
  document.getElementById('toggleAllAppeals')?.addEventListener('click', function() {
    const detailsElements = document.querySelectorAll('details[id^="accordion-"]');
    const shouldExpand = this.textContent.includes('Expand');

    detailsElements.forEach(details => {
      details.open = shouldExpand;
    });

    this.textContent = shouldExpand ? 'Collapse All' : 'Expand All';
  });
</script>
