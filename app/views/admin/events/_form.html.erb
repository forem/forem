<%
  available_parents = @available_parent_events || []
  selected_parent_ids = Array(@selected_parent_event_ids).map(&:to_i)
  available_orgs = @available_organizations || []
  current_banner_url = event.banner_image_url
  current_social_url = event.cover_image.presence&.url
  common_time_zones = %w[
    UTC
    America/New_York
    America/Chicago
    America/Denver
    America/Los_Angeles
    Europe/London
    Europe/Berlin
    Europe/Paris
    Asia/Kolkata
    Asia/Tokyo
    Australia/Sydney
  ]
  color_presets = ["#3B49DF", "#E5484D", "#0D9488", "#7C3AED", "#DB2777", "#D97706", "#2563EB", "#111827"]
%>
<%= form_with model: [:admin, event], local: true, html: { class: "admin-event-form" } do |form| %>
  <% if event.errors.any? %>
    <div class="crayons-notice crayons-notice--danger">
      <h4><%= pluralize(event.errors.count, "error") %> prohibited this event from being saved:</h4>
      <ul class="list-disc list-inside mt-2">
        <% event.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <!-- 1. Basics & Identity -->
  <section class="admin-event-form-section">
    <div class="admin-event-form-section__header">
      <h2 class="admin-event-form-section__title"><%= t("views.admin.events.form.sections.basics") %></h2>
      <p class="admin-event-form-section__subtitle"><%= t("views.admin.events.form.sections.basics_subtitle") %></p>
    </div>

    <div class="flex flex-col gap-4">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div class="crayons-field md:col-span-2">
          <%= form.label :title, class: "crayons-field__label" %>
          <%= form.text_field :title, class: "crayons-textfield", required: true, placeholder: "e.g. AI Engineer Europe 2027" %>
        </div>

        <div class="crayons-field">
          <%= form.label :type_of, "Event Type", class: "crayons-field__label" %>
          <%= form.select :type_of, Event.type_ofs.keys.map { |type| [type.titleize, type] }, {}, class: "crayons-select" %>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="crayons-field">
          <%= form.label :event_name_slug, "Event Name Slug", class: "crayons-field__label" do %>
            Event Name Slug *
            <p class="crayons-field__description">Root grouping slug (lowercase letters, numbers, dashes — e.g. 'aie-europe').</p>
          <% end %>
          <%= form.text_field :event_name_slug, class: "crayons-textfield", required: true, pattern: "[a-z0-9-]+", id: "event_name_slug_input" %>
        </div>

        <div class="crayons-field">
          <%= form.label :event_variation_slug, "Event Variation Slug", class: "crayons-field__label" do %>
            Event Variation Slug *
            <p class="crayons-field__description">Unique edition or session identifier (e.g. '2027' or 'opening-keynote').</p>
          <% end %>
          <%= form.text_field :event_variation_slug, class: "crayons-textfield", required: true, pattern: "[a-z0-9-]+", id: "event_variation_slug_input" %>
        </div>
      </div>

      <div>
        <span class="admin-event-url-preview">
          <span class="opacity-75"><%= t("views.admin.events.form.public_url_label") %>:</span>
          <strong id="admin-event-url-preview-text">/events/<%= event.event_name_slug.presence || "name-slug" %>/<%= event.event_variation_slug.presence || "variation" %></strong>
        </span>
      </div>

      <div class="crayons-field">
        <%= form.label :description, class: "crayons-field__label" do %>
          Description
          <p class="crayons-field__description">One or two sentences used for social previews, meta tags, event cards, and billboards (and as the page body if Page Body is blank).</p>
        <% end %>
        <%= form.text_area :description, class: "crayons-textfield", rows: 3 %>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="crayons-field">
          <%= form.label :tag_list, "Tags", class: "crayons-field__label" do %>
            Tags
            <p class="crayons-field__description">Comma-separated tags. The first tag powers the related community articles section.</p>
          <% end %>
          <%= form.text_field :tag_list, value: event.tag_list.join(", "), class: "crayons-textfield", placeholder: "ai, agents, architecture" %>
        </div>

        <div class="crayons-field">
          <%= form.label :organization_id, t("views.admin.events.form.host_organization"), class: "crayons-field__label" do %>
            <%= t("views.admin.events.form.host_organization") %>
            <p class="crayons-field__description"><%= t("views.admin.events.form.host_organization_description") %></p>
          <% end %>
          <%= form.select :organization_id,
                          available_orgs.map { |org| ["#{org.name} (@#{org.slug})", org.id] },
                          { include_blank: t("views.admin.events.form.no_organization") },
                          class: "crayons-select" %>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. Schedule & Location -->
  <section class="admin-event-form-section">
    <div class="admin-event-form-section__header">
      <h2 class="admin-event-form-section__title"><%= t("views.admin.events.form.sections.schedule") %></h2>
      <p class="admin-event-form-section__subtitle"><%= t("views.admin.events.form.sections.schedule_subtitle") %></p>
    </div>

    <div class="flex flex-col gap-4">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="crayons-field">
          <%= form.label :start_time, class: "crayons-field__label" do %>
            Start Time <span style="color:var(--brand-primary);">(Expected in UTC)</span>
          <% end %>
          <%= form.datetime_field :start_time, class: "crayons-textfield", required: true %>
          <div id="start_time_info"></div>
        </div>

        <div class="crayons-field">
          <%= form.label :end_time, class: "crayons-field__label" do %>
            End Time <span style="color:var(--brand-primary);">(Expected in UTC)</span>
          <% end %>
          <%= form.datetime_field :end_time, class: "crayons-textfield", required: true %>
          <div id="end_time_info"></div>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div class="crayons-field">
          <%= form.fields_for :data, event.data || {} do |data_form| %>
            <%= data_form.label :time_zone, t("views.admin.events.form.time_zone"), class: "crayons-field__label" do %>
              <%= t("views.admin.events.form.time_zone") %>
              <p class="crayons-field__description"><%= t("views.admin.events.form.time_zone_description") %></p>
            <% end %>
            <input type="text"
                   name="event[data][time_zone]"
                   id="event_data_time_zone"
                   list="common-event-time-zones"
                   class="crayons-textfield"
                   value="<%= event.data&.dig('time_zone') || event.data&.dig(:time_zone) %>"
                   placeholder="Europe/London">
            <datalist id="common-event-time-zones">
              <% common_time_zones.each do |tz| %>
                <option value="<%= tz %>"></option>
              <% end %>
            </datalist>
          <% end %>
        </div>

        <div class="crayons-field">
          <%= form.fields_for :data, event.data || {} do |data_form| %>
            <%= data_form.label :location, "Location Display", class: "crayons-field__label" do %>
              Location Display
              <p class="crayons-field__description">e.g. 'ExCeL London, UK' or 'Online Worldwide'</p>
            <% end %>
            <input type="text" name="event[data][location]" id="event_data_location" class="crayons-textfield" value="<%= event.data&.dig('location') || event.data&.dig(:location) %>" placeholder="Everywhere, Worldwide">
          <% end %>
        </div>

        <div class="crayons-field">
          <%= form.fields_for :data, event.data || {} do |data_form| %>
            <%= data_form.label :format, "Event Format Badge", class: "crayons-field__label" do %>
              Event Format Badge
              <p class="crayons-field__description">e.g. 'DIGITAL', 'IN-PERSON', 'HYBRID'</p>
            <% end %>
            <input type="text" name="event[data][format]" id="event_data_format" class="crayons-textfield" value="<%= event.data&.dig('format') || event.data&.dig(:format) %>" placeholder="HYBRID">
          <% end %>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="crayons-field">
          <%= form.fields_for :data, event.data || {} do |data_form| %>
            <%= data_form.label :registration_url, t("views.admin.events.form.registration_url"), class: "crayons-field__label" do %>
              <%= t("views.admin.events.form.registration_url") %>
              <p class="crayons-field__description"><%= t("views.admin.events.form.registration_url_description") %></p>
            <% end %>
            <input type="url" name="event[data][registration_url]" id="event_data_registration_url" class="crayons-textfield" value="<%= event.data&.dig('registration_url') || event.data&.dig(:registration_url) %>" placeholder="https://example.com/register">
          <% end %>
        </div>

        <div class="crayons-field">
          <%= form.fields_for :data, event.data || {} do |data_form| %>
            <%= data_form.label :website_url, t("views.admin.events.form.website_url"), class: "crayons-field__label" do %>
              <%= t("views.admin.events.form.website_url") %>
              <p class="crayons-field__description"><%= t("views.admin.events.form.website_url_description") %></p>
            <% end %>
            <input type="url" name="event[data][website_url]" id="event_data_website_url" class="crayons-textfield" value="<%= event.data&.dig('website_url') || event.data&.dig(:website_url) %>" placeholder="https://example.com">
          <% end %>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. Visual Branding & Media (Distinct Wide Banner vs Social/Card Image) -->
  <section class="admin-event-form-section">
    <div class="admin-event-form-section__header">
      <h2 class="admin-event-form-section__title"><%= t("views.admin.events.form.sections.branding") %></h2>
      <p class="admin-event-form-section__subtitle"><%= t("views.admin.events.form.sections.branding_subtitle") %></p>
    </div>

    <div class="flex flex-col gap-5">
      <div class="admin-event-media-grid">
        <!-- Wide Page Banner Image (5:1) -->
        <div class="admin-event-media-box">
          <div class="admin-event-media-box__header">
            <%= form.label :banner_image, t("views.admin.events.form.banner_image"), class: "crayons-field__label m-0" %>
            <span class="admin-event-media-box__ratio-badge">1600 × 320 · 5:1</span>
          </div>
          <p class="crayons-field__description m-0"><%= t("views.admin.events.form.banner_image_description") %></p>

          <div class="admin-event-media-box__preview admin-event-media-box__preview--banner" id="banner-image-preview-box">
            <% if current_banner_url.present? %>
              <img src="<%= current_banner_url %>" alt="<%= t("views.admin.events.form.banner_image_preview_alt") %>" id="banner-image-preview-img" />
            <% else %>
              <span class="admin-event-media-box__placeholder" id="banner-image-preview-empty">
                <%= t("views.admin.events.form.banner_image_empty") %>
              </span>
            <% end %>
          </div>

          <%= form.file_field :banner_image, accept: "image/*", class: "crayons-file-field", data: { preview_target: "banner-image-preview-box" } %>

          <% if event.banner_image.present? %>
            <label class="crayons-field crayons-field--checkbox flex items-center gap-2">
              <%= form.check_box :remove_banner_image, class: "crayons-checkbox" %>
              <span class="fs-s"><%= t("views.admin.events.form.remove_banner_image") %></span>
            </label>
          <% end %>

          <div class="crayons-field">
            <%= form.fields_for :data, event.data || {} do |data_form| %>
              <%= data_form.label :banner_image_url, t("views.admin.events.form.banner_image_url_fallback"), class: "crayons-field__label fs-xs" %>
              <input type="url"
                     name="event[data][banner_image_url]"
                     id="event_data_banner_image_url"
                     class="crayons-textfield"
                     value="<%= event.data&.dig('banner_image_url') || event.data&.dig(:banner_image_url) %>"
                     placeholder="https://...">
            <% end %>
          </div>
        </div>

        <!-- Social & Card Image (1200x630 / 1.91:1) -->
        <div class="admin-event-media-box">
          <div class="admin-event-media-box__header">
            <%= form.label :cover_image, t("views.admin.events.form.social_image"), class: "crayons-field__label m-0" %>
            <span class="admin-event-media-box__ratio-badge">1200 × 630 · 1.91:1</span>
          </div>
          <p class="crayons-field__description m-0"><%= t("views.admin.events.form.social_image_description") %></p>

          <div class="admin-event-media-box__preview admin-event-media-box__preview--social" id="social-image-preview-box">
            <% if current_social_url.present? %>
              <img src="<%= current_social_url %>" alt="<%= t("views.admin.events.form.social_image_preview_alt") %>" id="social-image-preview-img" />
            <% else %>
              <span class="admin-event-media-box__placeholder" id="social-image-preview-empty">
                <%= t("views.admin.events.form.social_image_empty") %>
              </span>
            <% end %>
          </div>

          <%= form.file_field :cover_image, accept: "image/*", class: "crayons-file-field", data: { preview_target: "social-image-preview-box" } %>

          <% if event.cover_image.present? %>
            <label class="crayons-field crayons-field--checkbox flex items-center gap-2">
              <%= form.check_box :remove_cover_image, class: "crayons-checkbox" %>
              <span class="fs-s"><%= t("views.admin.events.form.remove_social_image") %></span>
            </label>
          <% end %>
        </div>
      </div>

      <div class="crayons-field">
        <%= form.label :bg_color_hex, "Brand Accent Color", class: "crayons-field__label" do %>
          Brand Accent Color
          <p class="crayons-field__description">6-digit hex color used for the top brand line, navigation dot, and fallback card styling.</p>
        <% end %>
        <div class="flex items-center flex-wrap gap-3">
          <input type="color"
                 id="admin-event-color-picker"
                 value="<%= event.background_hex_color %>"
                 aria-label="Brand color picker"
                 style="width: 40px; height: 36px; border: 1px solid var(--base-20); border-radius: var(--radius); padding: 2px; background: transparent; cursor: pointer;" />
          <%= form.text_field :bg_color_hex, class: "crayons-textfield", placeholder: "#3B49DF", style: "max-width: 160px;", id: "admin-event-color-hex" %>
          <div class="admin-event-color-swatches">
            <% color_presets.each do |hex| %>
              <button type="button"
                      class="admin-event-color-swatch js-event-color-preset"
                      data-color="<%= hex %>"
                      style="background: <%= hex %>;"
                      title="<%= hex %>"
                      aria-label="Set brand color to <%= hex %>"></button>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. Event Hierarchy (Parent Events) -->
  <section class="admin-event-form-section">
    <div class="admin-event-form-section__header">
      <h2 class="admin-event-form-section__title"><%= t("views.admin.events.form.parent_events") %></h2>
      <p class="admin-event-form-section__subtitle"><%= t("views.admin.events.form.parent_events_description") %></p>
    </div>

    <input type="hidden" name="event[parent_event_ids][]" value="" />
    <% if available_parents.any? %>
      <div class="admin-event-parent-picker" id="admin-event-parent-picker">
        <div class="admin-event-parent-picker__selected" id="parent-event-selected-chips">
          <span class="admin-event-parent-picker__selected-label" id="parent-event-selected-count">
            <%= t("views.admin.events.form.selected_parents_count", count: selected_parent_ids.size) %>
          </span>
          <span class="fs-xs color-base-60" id="parent-event-none-selected" style="<%= selected_parent_ids.any? ? 'display: none;' : '' %>">
            <%= t("views.admin.events.form.top_level_hint") %>
          </span>
        </div>

        <div class="admin-event-parent-picker__controls">
          <input type="search"
                 id="parent-event-search"
                 class="crayons-textfield admin-event-parent-picker__search"
                 placeholder="<%= t("views.admin.events.form.search_parent_events") %>"
                 aria-label="<%= t("views.admin.events.form.search_parent_events") %>"
                 autocomplete="off" />

          <div class="admin-event-parent-picker__type-pills" id="parent-event-type-pills" role="group" aria-label="<%= t("views.admin.events.index.filter_by_type") %>">
            <button type="button" class="admin-event-parent-picker__type-pill is-active" data-parent-type-filter="">
              <%= t("views.admin.events.index.all_types") %>
            </button>
            <% %w[conference meetup live_stream challenge].each do |type_key| %>
              <button type="button" class="admin-event-parent-picker__type-pill" data-parent-type-filter="<%= type_key %>">
                <%= type_key.titleize %>
              </button>
            <% end %>
          </div>
        </div>

        <div class="admin-event-parent-picker__list" id="parent-event-picker-list">
          <% available_parents.each do |parent_option| %>
            <% is_checked = selected_parent_ids.include?(parent_option.id) %>
            <label class="admin-event-parent-picker__item <%= 'is-selected' if is_checked %>"
                   data-parent-search-text="<%= "#{parent_option.title} #{parent_option.type_of}".downcase %>"
                   data-parent-type="<%= parent_option.type_of %>"
                   data-parent-title="<%= parent_option.title %>"
                   data-parent-id="<%= parent_option.id %>">
              <input type="checkbox"
                     name="event[parent_event_ids][]"
                     value="<%= parent_option.id %>"
                     class="crayons-checkbox js-parent-event-checkbox"
                     <%= "checked" if is_checked %> />
              <span class="admin-event-parent-picker__item-title"><%= parent_option.title %></span>
              <span class="admin-event-parent-picker__item-meta">
                <span class="c-indicator fs-xs"><%= parent_option.type_of.titleize %></span>
                <% unless parent_option.published? %>
                  <span class="c-indicator c-indicator--warning fs-xs"><%= t("views.admin.events.status.draft") %></span>
                <% end %>
                <span class="fs-xs opacity-75 whitespace-nowrap"><%= parent_option.start_time.to_fs(:short) %></span>
              </span>
            </label>
          <% end %>
          <div class="admin-event-parent-picker__empty" id="parent-event-empty-state" style="display: none;">
            <%= t("views.admin.events.index.no_matching_events") %>
          </div>
        </div>
      </div>
    <% else %>
      <p class="fs-s color-base-60 italic m-0"><%= t("views.admin.events.form.no_parent_events_available") %></p>
    <% end %>
  </section>

  <!-- 5. Page Content & Agent Context -->
  <section class="admin-event-form-section">
    <div class="admin-event-form-section__header">
      <h2 class="admin-event-form-section__title"><%= t("views.admin.events.form.sections.content") %></h2>
      <p class="admin-event-form-section__subtitle"><%= t("views.admin.events.form.sections.content_subtitle") %></p>
    </div>

    <div class="flex flex-col gap-4">
      <div class="crayons-field">
        <%= form.label :body_markdown, "Page Body (Markdown)", class: "crayons-field__label" do %>
          Page Body (Markdown)
          <p class="crayons-field__description">Optional. Supports Markdown and Liquid tags. If left blank, the short Description is shown instead.</p>
        <% end %>
        <%= form.text_area :body_markdown, class: "crayons-textfield", rows: 10 %>
      </div>

      <details class="admin-details" <%= "open" if event.full_details.present? %>>
        <summary class="py-2 font-bold fs-s cursor-pointer color-base-80">
          Full Details (API Only / Agent Context)
          <span class="fs-xs fw-normal color-base-60 ml-1"><%= event.full_details.present? ? "(populated)" : "(optional)" %></span>
        </summary>
        <div class="crayons-field pt-2 pb-3">
          <p class="crayons-field__description mb-2">
            Dump comprehensive details, schedule, speaker bios, rules, and FAQs here. Exposed exclusively via the API for AI agents and integrations — never rendered on the public page.
          </p>
          <%= form.text_area :full_details, class: "crayons-textfield", rows: 6, placeholder: "Provide comprehensive event details, full schedule, rules, speaker bios, FAQs, and agent context..." %>
        </div>
      </details>
    </div>
  </section>

  <!-- 6. Livestream, Broadcast & Publishing -->
  <section class="admin-event-form-section">
    <div class="admin-event-form-section__header">
      <h2 class="admin-event-form-section__title"><%= t("views.admin.events.form.sections.publishing") %></h2>
      <p class="admin-event-form-section__subtitle"><%= t("views.admin.events.form.sections.publishing_subtitle") %></p>
    </div>

    <div class="flex flex-col gap-4">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="crayons-field">
          <%= form.label :primary_stream_url, "Primary Stream URL", class: "crayons-field__label" do %>
            Primary Stream URL
            <p class="crayons-field__description">YouTube, Twitch, or Streamyard URL (automatically normalized to embed format on save).</p>
          <% end %>
          <%= form.text_field :primary_stream_url, class: "crayons-textfield", placeholder: "https://www.youtube.com/watch?v=..." %>
        </div>

        <div class="crayons-field">
          <%= form.fields_for :data, event.data || {} do |data_form| %>
            <%= data_form.label :chat_url, "Chat Embed URL", class: "crayons-field__label" do %>
              Chat Embed URL
              <p class="crayons-field__description">Optional live chat embed URL (YouTube or Twitch chat).</p>
            <% end %>
            <input type="text" name="event[data][chat_url]" id="event_data_chat_url" class="crayons-textfield" value="<%= event.data&.dig('chat_url') || event.data&.dig(:chat_url) %>">
          <% end %>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="crayons-field">
          <%= form.label :broadcast_config, "Billboard Broadcast Config", class: "crayons-field__label" do %>
            Billboard Broadcast Config
            <p class="crayons-field__description">No Broadcast = disabled. Tagged = targets event tags. Global = all users.</p>
          <% end %>
          <%= form.select :broadcast_config, Event.broadcast_configs.keys.map { |cfg| [cfg.titleize, cfg] }, {}, class: "crayons-select" %>
        </div>

        <div class="crayons-field">
          <%= form.fields_for :data, event.data || {} do |data_form| %>
            <%= data_form.label :auto_follow_tag_names, "Auto-Follow Tags on Signup (Challenges)", class: "crayons-field__label" do %>
              Auto-Follow Tags on Signup (Challenges)
              <p class="crayons-field__description">Comma-separated tags users auto-follow when joining a challenge.</p>
            <% end %>
            <input type="text" name="event[data][auto_follow_tag_names]" id="event_data_auto_follow_tag_names" class="crayons-textfield" value="<%= event.data&.dig('auto_follow_tag_names') %>" placeholder="devchallenge, writeathon">
          <% end %>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-3 pt-2">
        <div class="crayons-field crayons-field--checkbox">
          <%= form.check_box :published, class: "crayons-checkbox" %>
          <%= form.label :published, class: "crayons-field__label" do %>
            Published
            <p class="crayons-field__description">Makes the event publicly accessible (unchecked = admin-only draft).</p>
          <% end %>
        </div>

        <div class="crayons-field crayons-field--checkbox">
          <%= form.check_box :elevated, class: "crayons-checkbox" %>
          <%= form.label :elevated, class: "crayons-field__label" do %>
            Elevated
            <p class="crayons-field__description">Highlights the event in the homepage sidebar.</p>
          <% end %>
        </div>

        <div class="crayons-field crayons-field--checkbox">
          <%= form.check_box :allow_articles, class: "crayons-checkbox" %>
          <%= form.label :allow_articles, class: "crayons-field__label" do %>
            <%= t("views.admin.events.form.allow_articles") %>
            <p class="crayons-field__description"><%= t("views.admin.events.form.allow_articles_description") %></p>
          <% end %>
        </div>

        <div class="crayons-field crayons-field--checkbox">
          <%= form.check_box :manual_broadcast_end, class: "crayons-checkbox" %>
          <%= form.label :manual_broadcast_end, class: "crayons-field__label" do %>
            Manually End Broadcast
            <p class="crayons-field__description">Hold broadcast billboards open past End Time until manually ended.</p>
          <% end %>
        </div>
      </div>

      <details class="admin-details" <%= "open" if event.delegate_to_page? || event.page_id.present? %>>
        <summary class="py-2 font-bold fs-s cursor-pointer color-base-80">
          <%= t("views.admin.events.form.advanced_delegation") %>
        </summary>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pt-3 pb-2">
          <div class="crayons-field">
            <%= form.label :page_id, "Delegated Page", class: "crayons-field__label" do %>
              Delegated Page
              <p class="crayons-field__description">Optional legacy Page redirect target for this event.</p>
            <% end %>
            <%= form.select :page_id, Page.order(:title).pluck(:title, :id), { include_blank: "None (No page delegation)" }, class: "crayons-select" %>
          </div>

          <div class="crayons-field crayons-field--checkbox mt-6">
            <%= form.check_box :delegate_to_page, class: "crayons-checkbox" %>
            <%= form.label :delegate_to_page, class: "crayons-field__label" do %>
              Delegate to Page
              <p class="crayons-field__description">Redirect links for this event directly to the selected Page.</p>
            <% end %>
          </div>
        </div>
      </details>
    </div>
  </section>

  <!-- Sticky Save Bar -->
  <div class="admin-event-form-footer">
    <div class="flex items-center gap-2">
      <%= link_to t("views.admin.events.form.cancel"), event.persisted? ? admin_event_path(event) : admin_events_path, class: "c-btn c-btn--secondary" %>
    </div>
    <div class="flex items-center gap-2">
      <%= form.submit class: "c-btn c-btn--primary" %>
    </div>
  </div>
<% end %>

<script>
  (function() {
    // 1. Live URL slug preview
    const nameSlugInput = document.getElementById("event_name_slug_input");
    const varSlugInput = document.getElementById("event_variation_slug_input");
    const urlPreview = document.getElementById("admin-event-url-preview-text");
    function updateUrlPreview() {
      if (!urlPreview) return;
      const n = (nameSlugInput && nameSlugInput.value.trim()) || "name-slug";
      const v = (varSlugInput && varSlugInput.value.trim()) || "variation";
      urlPreview.textContent = "/events/" + n + "/" + v;
    }
    if (nameSlugInput) nameSlugInput.addEventListener("input", updateUrlPreview);
    if (varSlugInput) varSlugInput.addEventListener("input", updateUrlPreview);

    // 2. UTC -> local time helper
    const startInput = document.getElementById("event_start_time");
    const endInput = document.getElementById("event_end_time");
    function updateTimeInfo(inputEl, displayElId) {
      const displayEl = document.getElementById(displayElId);
      if (!displayEl || !inputEl.value) {
        if (displayEl) displayEl.innerHTML = "";
        return;
      }
      const utcTime = new Date(inputEl.value + "Z");
      if (isNaN(utcTime)) return;

      const localString = utcTime.toLocaleString(undefined, { weekday: "short", year: "numeric", month: "short", day: "numeric", hour: "2-digit", minute: "2-digit", timeZoneName: "short" });
      const utcString = utcTime.toUTCString();
      const diffHours = ((utcTime - new Date()) / (1000 * 60 * 60)).toFixed(1);
      const relativeInfo = Number(diffHours) >= 0 ? `in ${diffHours} hours` : `${Math.abs(diffHours)} hours ago`;

      displayEl.innerHTML = `
        <div style="background-color: var(--base-5); border: 1px solid var(--base-20); border-left: 3px solid var(--accent-brand); border-radius: 6px; padding: 8px 10px; margin-top: 6px; font-size: var(--fs-xs);">
          <div><strong>UTC:</strong> ${utcString}</div>
          <div style="color: var(--accent-brand);"><strong>Your local time:</strong> ${localString} (${relativeInfo})</div>
        </div>
      `;
    }
    if (startInput) {
      startInput.addEventListener("input", () => updateTimeInfo(startInput, "start_time_info"));
      updateTimeInfo(startInput, "start_time_info");
    }
    if (endInput) {
      endInput.addEventListener("input", () => updateTimeInfo(endInput, "end_time_info"));
      updateTimeInfo(endInput, "end_time_info");
    }

    // 3. Brand color picker + preset swatches sync
    const colorPicker = document.getElementById("admin-event-color-picker");
    const colorHex = document.getElementById("admin-event-color-hex");
    if (colorPicker && colorHex) {
      colorPicker.addEventListener("input", function() {
        colorHex.value = colorPicker.value.toUpperCase();
      });
      colorHex.addEventListener("input", function() {
        if (/^#[0-9a-fA-F]{6}$/.test(colorHex.value.trim())) {
          colorPicker.value = colorHex.value.trim();
        }
      });
      document.querySelectorAll(".js-event-color-preset").forEach(function(btn) {
        btn.addEventListener("click", function() {
          colorHex.value = btn.dataset.color;
          colorPicker.value = btn.dataset.color;
        });
      });
    }

    // 4. Instant file upload preview for Wide Banner & Social Image
    document.querySelectorAll('input[type="file"][data-preview-target]').forEach(function(input) {
      input.addEventListener("change", function() {
        const box = document.getElementById(input.dataset.previewTarget);
        const file = input.files && input.files[0];
        if (!box || !file) return;
        const objectUrl = URL.createObjectURL(file);
        box.innerHTML = "";
        const img = document.createElement("img");
        img.src = objectUrl;
        img.alt = "Image preview";
        box.appendChild(img);
      });
    });

    // 5. Interactive Parent Events Picker (search + type filter + selected chips)
    const picker = document.getElementById("admin-event-parent-picker");
    if (picker) {
      const searchInput = document.getElementById("parent-event-search");
      const list = document.getElementById("parent-event-picker-list");
      const emptyState = document.getElementById("parent-event-empty-state");
      const chipsWrap = document.getElementById("parent-event-selected-chips");
      const countEl = document.getElementById("parent-event-selected-count");
      const noneEl = document.getElementById("parent-event-none-selected");
      const typePills = document.getElementById("parent-event-type-pills");
      let activeType = "";

      function applyParentFilters() {
        const q = (searchInput ? searchInput.value : "").trim().toLowerCase();
        let visibleCount = 0;
        list.querySelectorAll(".admin-event-parent-picker__item").forEach(function(item) {
          const hay = item.dataset.parentSearchText || "";
          const itemType = item.dataset.parentType || "";
          const matchesQuery = !q || hay.includes(q);
          const matchesType = !activeType || itemType === activeType;
          const show = matchesQuery && matchesType;
          item.style.display = show ? "" : "none";
          if (show) visibleCount += 1;
        });
        if (emptyState) emptyState.style.display = visibleCount === 0 ? "" : "none";
      }

      function renderSelectedChips() {
        chipsWrap.querySelectorAll(".admin-event-parent-picker__selected-chip").forEach(function(c) { c.remove(); });
        const checked = list.querySelectorAll(".js-parent-event-checkbox:checked");
        if (countEl) {
          countEl.textContent = <%= t("views.admin.events.form.selected_parents_label").to_json.html_safe %> + " (" + checked.length + ")";
        }
        if (noneEl) noneEl.style.display = checked.length === 0 ? "" : "none";

        checked.forEach(function(cb) {
          const item = cb.closest(".admin-event-parent-picker__item");
          if (!item) return;
          const chip = document.createElement("span");
          chip.className = "admin-event-parent-picker__selected-chip";
          const label = document.createElement("span");
          label.textContent = item.dataset.parentTitle || "";
          const removeBtn = document.createElement("button");
          removeBtn.type = "button";
          removeBtn.className = "admin-event-parent-picker__selected-remove";
          removeBtn.setAttribute("aria-label", "Remove " + (item.dataset.parentTitle || ""));
          removeBtn.textContent = "×";
          removeBtn.addEventListener("click", function() {
            cb.checked = false;
            item.classList.remove("is-selected");
            renderSelectedChips();
          });
          chip.appendChild(label);
          chip.appendChild(removeBtn);
          chipsWrap.appendChild(chip);
        });
      }

      list.addEventListener("change", function(e) {
        const cb = e.target.closest(".js-parent-event-checkbox");
        if (!cb) return;
        const item = cb.closest(".admin-event-parent-picker__item");
        if (item) item.classList.toggle("is-selected", cb.checked);
        renderSelectedChips();
      });

      if (searchInput) searchInput.addEventListener("input", applyParentFilters);

      if (typePills) {
        typePills.addEventListener("click", function(e) {
          const pill = e.target.closest("[data-parent-type-filter]");
          if (!pill) return;
          activeType = pill.dataset.parentTypeFilter || "";
          typePills.querySelectorAll("[data-parent-type-filter]").forEach(function(p) {
            p.classList.toggle("is-active", p === pill);
          });
          applyParentFilters();
        });
      }

      renderSelectedChips();
    }
  })();
</script>
