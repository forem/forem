<%
  event_markdown_pages = @event.ordered_pages.to_a
  event_embed_pages = @event.ordered_embed_pages.to_a
  total_pages_count = event_markdown_pages.size + event_embed_pages.size
  hierarchy_count = @parent_memberships.size + @child_memberships.size
  billboards_count = @event.billboards.size
  signups_count = @event_signups.total_count
  uploaded_banner_url = @event.banner_image.present? ? safe_event_url(@event.banner_image.banner.url || @event.banner_image.url) : nil
  external_banner_url = safe_event_url(@event.data&.dig("banner_image_url") || @event.data&.dig(:banner_image_url))
  social_preview_url = @event.cover_image.present? ? safe_event_url(@event.cover_image.url) : nil
%>

<div class="admin-events-page">
  <div class="crayons-card p-6">
    <div class="mb-3">
      <%= link_to "← #{t('views.admin.events.show.back_to_events')}", admin_events_path, class: "c-link fs-s" %>
    </div>

    <div class="admin-events-header mb-4">
      <div>
        <div class="flex items-center gap-2 flex-wrap">
          <span class="admin-event-color-dot" style="background-color: <%= @event.background_hex_color %>; margin-top: 0;" aria-hidden="true"></span>
          <h1 class="crayons-title m-0"><%= @event.title %></h1>
          <% if @event.published? %>
            <span class="c-indicator c-indicator--success"><%= t("views.admin.events.status.published") %></span>
          <% else %>
            <span class="c-indicator c-indicator--warning"><%= t("views.admin.events.status.draft") %></span>
          <% end %>
          <% if @event.live? %>
            <span class="admin-event-chip admin-event-chip--live"><%= t("views.events.gathering.live") %></span>
          <% end %>
          <span class="admin-event-chip admin-event-chip--role"><%= @event.type_of.titleize %></span>
        </div>
        <div class="admin-event-url-preview mt-2">
          <code>/events/<%= @event.event_name_slug %>/<%= @event.event_variation_slug %></code>
        </div>
      </div>

      <div class="flex flex-wrap gap-2">
        <%= link_to "Edit Event", edit_admin_event_path(@event), class: "c-btn c-btn--primary" %>
        <%= link_to t("views.admin.event_pages.manage_pages"), admin_event_pages_path(@event), class: "c-btn c-btn--secondary" %>
        <%= link_to t("views.admin.events.fork_event"), new_admin_event_path(fork_from_id: @event.id), class: "c-btn c-btn--secondary" %>
        <%= link_to "Public View ↗", event_path(@event.event_name_slug, @event.event_variation_slug), target: "_blank", rel: "noopener", class: "c-btn c-btn--secondary" %>
      </div>
    </div>

    <nav class="admin-event-jump-nav" aria-label="Event sections">
      <a href="#event-overview" class="admin-event-jump-nav__link">
        <%= t("views.admin.events.show.jump_overview") %>
      </a>
      <a href="#event-hierarchy" class="admin-event-jump-nav__link">
        <%= t("views.admin.events.show.jump_hierarchy") %>
        <span class="admin-event-jump-nav__count"><%= hierarchy_count %></span>
      </a>
      <a href="#event-pages" class="admin-event-jump-nav__link">
        <%= t("views.admin.events.show.jump_pages") %>
        <span class="admin-event-jump-nav__count"><%= total_pages_count %></span>
      </a>
      <a href="#event-billboards" class="admin-event-jump-nav__link">
        <%= t("views.admin.events.show.jump_billboards") %>
        <span class="admin-event-jump-nav__count"><%= billboards_count %></span>
      </a>
      <a href="#event-signups" class="admin-event-jump-nav__link">
        <%= t("views.admin.events.show.jump_signups") %>
        <span class="admin-event-jump-nav__count"><%= signups_count %></span>
      </a>
    </nav>

    <section id="event-overview" class="mb-8">
      <div class="admin-event-show-grid mb-6">
        <div class="admin-event-info-card">
          <h2 class="text-lg font-bold mt-0 mb-3">General Settings</h2>
          <ul class="space-y-2 m-0 p-0" style="list-style: none;">
            <li><strong>Title:</strong> <%= @event.title %></li>
            <li><strong>Event Name Slug:</strong> <code><%= @event.event_name_slug %></code></li>
            <li><strong>Event Variation Slug:</strong> <code><%= @event.event_variation_slug %></code></li>
            <% if @event.organization.present? %>
              <li><strong>Host Organization:</strong> <%= @event.organization.name %> (<code>/<%= @event.organization.slug %></code>)</li>
            <% end %>
            <li><strong>Tags:</strong> <%= @event.tag_list.any? ? @event.tag_list.join(", ") : t("views.admin.events.show.not_configured") %></li>
            <li>
              <strong>Brand Accent Color:</strong>
              <span style="display:inline-block; width:16px; height:16px; background-color:<%= @event.background_hex_color %>; vertical-align:middle; border-radius:3px; margin-right:4px; border: 1px solid var(--card-border);"></span>
              <code><%= @event.background_hex_color %></code>
              <% if @event.bg_color_hex.present? %>
                <span class="fs-xs opacity-75">(stored)</span>
              <% else %>
                <span class="fs-xs opacity-75">(dynamic fallback)</span>
              <% end %>
            </li>
          </ul>
        </div>

        <div class="admin-event-info-card">
          <h2 class="text-lg font-bold mt-0 mb-3">Broadcast &amp; Schedule</h2>
          <ul class="space-y-2 m-0 p-0" style="list-style: none;">
            <li>
              <strong>Status:</strong>
              <% if @event.published? %>
                <span class="c-indicator c-indicator--success">Published</span>
              <% else %>
                <span class="c-indicator c-indicator--warning">Draft</span>
              <% end %>
            </li>
            <% if @event.manual_broadcast_end? %>
              <li>
                <strong>Manual Termination:</strong>
                <% if @event.broadcast_ended_at.present? %>
                  <span class="c-indicator">Closed</span>
                  <span class="fs-xs opacity-75">(<%= @event.broadcast_ended_at.to_fs(:short) %>)</span>
                <% else %>
                  <span class="c-indicator c-indicator--warning">Holding: Waiting for trigger</span>
                <% end %>
              </li>
            <% end %>
            <li><strong>Event Type:</strong> <%= @event.type_of.titleize %></li>
            <li><strong>Broadcast Config:</strong> <%= @event.broadcast_config.titleize %></li>
            <li>
              <strong><%= t("views.admin.events.show.allow_articles") %>:</strong>
              <% if @event.allow_articles? %>
                <span class="c-indicator c-indicator--success"><%= t("views.admin.events.show.enabled") %></span>
              <% else %>
                <span class="c-indicator"><%= t("views.admin.events.show.disabled") %></span>
              <% end %>
              <span class="fs-xs opacity-75">(<%= t("views.admin.events.show.tagged_articles_count", count: @event.articles.count) %>)</span>
            </li>
            <li>
              <strong>Start Time:</strong>
              <span class="utc-time" data-iso="<%= @event.start_time.iso8601 %>"><%= @event.start_time %></span>
            </li>
            <li>
              <strong>End Time:</strong>
              <span class="utc-time" data-iso="<%= @event.end_time.iso8601 %>"><%= @event.end_time %></span>
            </li>
          </ul>
        </div>
      </div>

      <div class="mb-6">
        <div class="flex items-center justify-between flex-wrap gap-2 mb-3">
          <h2 class="text-lg font-bold m-0"><%= t("views.admin.events.show.media_heading") %></h2>
          <%= link_to t("views.admin.events.show.edit_media"), edit_admin_event_path(@event, anchor: "branding"), class: "c-btn c-btn--secondary c-btn--sm" %>
        </div>
        <div class="admin-event-media-grid">
          <div class="admin-event-media-box">
            <div class="admin-event-media-box__header">
              <strong class="fs-s"><%= t("views.admin.events.show.banner_image") %></strong>
              <span class="admin-event-media-box__ratio-badge">1600×320 · 5:1</span>
            </div>
            <div class="admin-event-media-box__preview admin-event-media-box__preview--banner">
              <% if uploaded_banner_url.present? %>
                <img src="<%= uploaded_banner_url %>" alt="<%= t('views.admin.events.form.banner_image_preview_alt') %>" />
              <% elsif external_banner_url.present? %>
                <span class="admin-event-media-box__placeholder">
                  <%= t("views.admin.events.form.external_banner_configured") %>
                  <%= link_to external_banner_url, external_banner_url, target: "_blank", rel: "noopener noreferrer", class: "c-link" %>
                </span>
              <% else %>
                <span class="admin-event-media-box__placeholder"><%= t("views.admin.events.show.not_configured") %></span>
              <% end %>
            </div>
          </div>

          <div class="admin-event-media-box">
            <div class="admin-event-media-box__header">
              <strong class="fs-s"><%= t("views.admin.events.show.social_image") %></strong>
              <span class="admin-event-media-box__ratio-badge">1200×630 · 1.91:1</span>
            </div>
            <div class="admin-event-media-box__preview admin-event-media-box__preview--social">
              <% if social_preview_url.present? %>
                <img src="<%= social_preview_url %>" alt="<%= t('views.admin.events.form.social_image_preview_alt') %>" />
              <% else %>
                <span class="admin-event-media-box__placeholder"><%= t("views.admin.events.show.using_site_default_social") %></span>
              <% end %>
            </div>
          </div>
        </div>
      </div>

      <div class="admin-event-show-grid">
        <div class="admin-event-info-card">
          <h2 class="text-lg font-bold mt-0 mb-3">Stream Links &amp; Data</h2>
          <ul class="space-y-2 m-0 p-0" style="list-style: none;">
            <li><strong>Primary Stream URL:</strong> <%= @event.primary_stream_url.presence || t("views.admin.events.show.not_configured") %></li>
            <% if @event.data.present? %>
              <% @event.data.each do |key, value| %>
                <% next if value.blank? %>
                <li style="word-break: break-word;"><strong>Data [<%= key %>]:</strong> <%= value %></li>
              <% end %>
            <% end %>
          </ul>
        </div>

        <div class="admin-event-info-card">
          <h2 class="text-lg font-bold mt-0 mb-3">Full Details (API Only / Agent Context)</h2>
          <% if @event.full_details.present? %>
            <div class="p-3 bg-base-0 rounded border border-base-20" style="white-space: pre-wrap; font-family: monospace; font-size: var(--fs-xs); line-height: 1.55; max-height: 260px; overflow-y: auto;">
              <%= @event.full_details %>
            </div>
          <% else %>
            <p class="color-base-60 italic m-0">No full details dump provided yet.</p>
          <% end %>
        </div>
      </div>
    </section>

    <hr class="my-8" />

    <section id="event-hierarchy" class="mb-8">
      <div class="flex items-center justify-between flex-wrap gap-3 mb-4">
        <div>
          <h2 class="text-2xl font-bold m-0"><%= t("views.admin.event_memberships.heading") %></h2>
          <p class="fs-s color-base-60 mt-1 mb-0"><%= t("views.admin.event_memberships.subtitle") %></p>
        </div>
        <%= link_to t("views.admin.event_memberships.create_sub_event"),
                    new_admin_event_path(parent_event_id: @event.id),
                    class: "c-btn c-btn--primary c-btn--sm" %>
      </div>

      <% if @parent_memberships.any? %>
        <div class="mb-6">
          <h3 class="text-lg font-bold mb-2"><%= t("views.admin.event_memberships.belongs_to_heading") %></h3>
          <ul class="space-y-2 m-0 p-0" style="list-style: none;">
            <% @parent_memberships.each do |pm| %>
              <% parent = pm.parent_event %>
              <% next unless parent %>
              <li class="flex items-center justify-between flex-wrap gap-2 p-3 border rounded">
                <div class="flex items-center gap-2 flex-wrap">
                  <span class="admin-event-color-dot" style="background-color: <%= parent.background_hex_color %>; margin-top: 0;" aria-hidden="true"></span>
                  <%= link_to parent.title, admin_event_path(parent), class: "font-bold c-link" %>
                  <span class="c-indicator"><%= parent.type_of.titleize %></span>
                  <% unless parent.published? %>
                    <span class="c-indicator c-indicator--warning"><%= t("views.admin.events.status.draft") %></span>
                  <% end %>
                  <% if pm.role.present? %>
                    <span class="admin-event-chip admin-event-chip--role"><%= pm.role %></span>
                  <% end %>
                  <% if pm.featured? %>
                    <span class="admin-event-chip admin-event-chip--featured">★ <%= t("views.admin.events.index.featured") %></span>
                  <% end %>
                </div>
                <div class="flex items-center gap-2">
                  <%= link_to t("views.admin.event_memberships.view_parent"), admin_event_path(parent), class: "c-btn c-btn--secondary c-btn--sm" %>
                  <%= button_to t("views.admin.event_memberships.detach"),
                                admin_event_membership_path(parent, pm, return_to_event_id: @event.id),
                                method: :delete,
                                form: { data: { turbo: false } },
                                data: { confirm: t("views.admin.event_memberships.detach_confirm") },
                                class: "c-btn c-btn--destructive c-btn--sm" %>
                </div>
              </li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <h3 class="text-lg font-bold mb-3">
        <%= t("views.admin.event_memberships.sub_events_heading") %>
        <span class="fs-s opacity-75">(<%= @child_memberships.size %>)</span>
      </h3>

      <% if @child_memberships.any? %>
        <div style="overflow-x: auto;" class="mb-4">
          <table class="crayons-table admin-events-table">
            <thead>
              <tr>
                <th><%= t("views.admin.event_memberships.headers.order") %></th>
                <th><%= t("views.admin.event_memberships.headers.sub_event") %></th>
                <th><%= t("views.admin.event_memberships.headers.schedule") %></th>
                <th><%= t("views.admin.event_memberships.headers.membership_settings") %></th>
                <th><%= t("views.admin.event_memberships.headers.actions") %></th>
              </tr>
            </thead>
            <tbody>
              <% now = Time.current %>
              <% @child_memberships.each_with_index do |membership, idx| %>
                <% child = membership.child_event %>
                <% next unless child %>
                <tr>
                  <td class="whitespace-nowrap">
                    <div class="flex items-center gap-1">
                      <%= button_to "↑",
                                    reorder_admin_event_membership_path(@event, membership, direction: "up"),
                                    method: :patch,
                                    disabled: idx.zero?,
                                    class: "c-btn c-btn--secondary c-btn--sm",
                                    title: t("views.admin.event_memberships.move_up") %>
                      <%= button_to "↓",
                                    reorder_admin_event_membership_path(@event, membership, direction: "down"),
                                    method: :patch,
                                    disabled: idx == @child_memberships.size - 1,
                                    class: "c-btn c-btn--secondary c-btn--sm",
                                    title: t("views.admin.event_memberships.move_down") %>
                    </div>
                  </td>
                  <td>
                    <div class="font-bold">
                      <%= link_to child.title, admin_event_path(child), class: "c-link" %>
                    </div>
                    <div class="flex flex-wrap items-center gap-1 mt-1">
                      <span class="c-indicator"><%= child.type_of.titleize %></span>
                      <% if child.live?(now) %>
                        <span class="admin-event-chip admin-event-chip--live"><%= t("views.events.gathering.live") %></span>
                      <% elsif child.upcoming?(now) %>
                        <span class="c-indicator"><%= t("views.events.gathering.upcoming") %></span>
                      <% else %>
                        <span class="c-indicator"><%= t("views.events.gathering.ended") %></span>
                      <% end %>
                      <% unless child.published? %>
                        <span class="c-indicator c-indicator--warning"><%= t("views.admin.events.status.draft") %></span>
                      <% end %>
                    </div>
                  </td>
                  <td class="whitespace-nowrap fs-s">
                    <div><%= child.start_time.to_fs(:short) %></div>
                    <div class="opacity-75">→ <%= child.end_time.to_fs(:short) %></div>
                  </td>
                  <td>
                    <%= form_with model: [:admin, @event, membership], url: admin_event_membership_path(@event, membership), method: :patch, local: true, class: "flex items-center flex-wrap gap-2" do |mf| %>
                      <%= mf.text_field :role, value: membership.role, placeholder: t("views.admin.event_memberships.role_placeholder"), class: "crayons-textfield", style: "max-width: 150px;" %>
                      <label class="flex items-center gap-1 fs-xs whitespace-nowrap">
                        <%= mf.check_box :featured, checked: membership.featured?, class: "crayons-checkbox" %>
                        <span><%= t("views.admin.events.index.featured") %></span>
                      </label>
                      <%= mf.submit t("views.admin.event_memberships.save"), class: "c-btn c-btn--secondary c-btn--sm" %>
                    <% end %>
                  </td>
                  <td>
                    <div class="flex flex-wrap gap-2">
                      <%= link_to "Edit", edit_admin_event_path(child), class: "c-btn c-btn--secondary c-btn--sm" %>
                      <%= link_to "Public ↗", event_path(child.event_name_slug, child.event_variation_slug), target: "_blank", rel: "noopener", class: "c-btn c-btn--secondary c-btn--sm" %>
                      <%= button_to t("views.admin.event_memberships.detach"),
                                    admin_event_membership_path(@event, membership),
                                    method: :delete,
                                    form: { data: { turbo: false } },
                                    data: { confirm: t("views.admin.event_memberships.detach_confirm") },
                                    class: "c-btn c-btn--destructive c-btn--sm" %>
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <p class="color-base-60 italic mb-4"><%= t("views.admin.event_memberships.no_sub_events") %></p>
      <% end %>

      <% if @available_sub_events.any? %>
        <div class="admin-hierarchy-card">
          <h4 class="font-bold mt-0 mb-3"><%= t("views.admin.event_memberships.attach_existing") %></h4>
          <div class="mb-3" style="max-width: 360px;">
            <input type="search"
                   id="attach-sub-event-filter"
                   class="crayons-textfield"
                   placeholder="<%= t('views.admin.event_memberships.filter_candidates_placeholder') %>"
                   aria-label="<%= t('views.admin.event_memberships.filter_candidates_placeholder') %>" />
          </div>
          <%= form_with url: admin_event_memberships_path(@event), scope: :event_membership, method: :post, local: true, class: "flex items-end flex-wrap gap-3" do |mf| %>
            <div class="crayons-field flex-1" style="min-width: 240px;">
              <%= mf.label :child_event_id, t("views.admin.event_memberships.select_event"), for: "attach-sub-event-select", class: "crayons-field__label" %>
              <%= mf.select :child_event_id,
                            @available_sub_events.map { |candidate|
                              status_tag = candidate.published? ? "" : " [#{t('views.admin.events.status.draft')}]"
                              ["#{candidate.title} (#{candidate.type_of.titleize} · #{candidate.start_time.to_fs(:short)})#{status_tag}", candidate.id]
                            },
                            { include_blank: t("views.admin.event_memberships.choose_event_prompt") },
                            class: "crayons-select", id: "attach-sub-event-select", required: true %>
            </div>
            <div class="crayons-field" style="min-width: 170px;">
              <%= mf.label :role, t("views.admin.event_memberships.role_label"), class: "crayons-field__label" %>
              <%= mf.text_field :role, placeholder: t("views.admin.event_memberships.role_placeholder"), class: "crayons-textfield" %>
            </div>
            <div class="crayons-field crayons-field--checkbox pb-2">
              <%= mf.check_box :featured, class: "crayons-checkbox" %>
              <%= mf.label :featured, t("views.admin.events.index.featured"), class: "crayons-field__label" %>
            </div>
            <div class="pb-1">
              <%= mf.submit t("views.admin.event_memberships.attach_button"), class: "c-btn c-btn--primary" %>
            </div>
          <% end %>
        </div>
      <% end %>
    </section>

    <hr class="my-8" />

    <section id="event-pages" class="mb-8">
      <div class="flex items-center justify-between flex-wrap gap-3 mb-4">
        <h2 class="text-2xl font-bold m-0"><%= t("views.admin.event_pages.heading") %></h2>
        <div class="flex gap-2 flex-wrap">
          <%= link_to t("views.admin.event_pages.new_page"), new_admin_event_page_path(@event), class: "c-btn c-btn--secondary c-btn--sm" %>
          <%= link_to t("views.organization_settings.pages.new_embed_page"), new_admin_event_page_path(@event, kind: "embed"), class: "c-btn c-btn--secondary c-btn--sm" %>
          <%= link_to t("views.admin.event_pages.manage_pages"), admin_event_pages_path(@event), class: "c-btn c-btn--primary c-btn--sm" %>
        </div>
      </div>
      <% if event_markdown_pages.any? || event_embed_pages.any? %>
        <ul class="space-y-2 m-0 p-0 mb-6" style="list-style: none;">
          <% event_markdown_pages.each do |event_page| %>
            <% suffix = event_page.slug.to_s.split("/").last %>
            <li class="flex items-center justify-between gap-2 p-3 border rounded">
              <div class="flex items-center gap-2 flex-wrap">
                <strong><%= event_page.title %></strong>
                <% if event_page.event_showcase? %>
                  <span class="c-indicator c-indicator--success"><%= t("views.admin.event_pages.showcase") %></span>
                <% else %>
                  <code class="fs-xs">/p/<%= suffix %></code>
                <% end %>
                <% unless event_page.event_showcase? || event_page.show_in_navigation? %>
                  <span class="c-indicator"><%= t("views.organization_settings.pages.hidden_from_tabs") %></span>
                <% end %>
              </div>
              <%= link_to t("views.organization_settings.pages.edit"), edit_admin_event_page_path(@event, event_page), class: "c-btn c-btn--secondary c-btn--sm" %>
            </li>
          <% end %>
          <% event_embed_pages.each do |embed_page| %>
            <li class="flex items-center justify-between gap-2 p-3 border rounded">
              <div class="flex items-center gap-2 flex-wrap">
                <strong><%= embed_page.title %></strong>
                <span class="c-indicator"><%= t("views.organization_settings.pages.embed_only_badge") %></span>
              </div>
              <%= link_to t("views.organization_settings.pages.edit"), edit_admin_event_page_path(@event, embed_page), class: "c-btn c-btn--secondary c-btn--sm" %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="color-base-60 italic mb-6"><%= t("views.admin.event_pages.no_pages") %></p>
      <% end %>
    </section>

    <hr class="my-8" />

    <section id="event-billboards" class="mb-8">
      <div class="flex items-center justify-between flex-wrap gap-3 mb-6">
        <h2 class="text-2xl font-bold m-0">Generated Billboards</h2>
        <div class="flex items-center gap-2">
          <% if @event.manual_broadcast_end? && @event.broadcast_ended_at.nil? && @event.published? %>
            <%= button_to "End Broadcast", end_broadcast_admin_event_path(@event), method: :patch, form: { data: { turbo: false } }, data: { confirm: "Are you sure? This will tear down all active billboards." }, class: "c-btn c-btn--danger c-btn--sm" %>
          <% end %>
          <% if @event.live_stream? %>
            <button id="toggle-stream-btn" class="c-btn c-btn--secondary c-btn--sm">Test Stream Transition</button>
          <% end %>
        </div>
      </div>

      <% if @event.billboards.any? %>
        <div class="admin-event-show-grid">
          <% @event.billboards.each do |billboard| %>
            <div class="crayons-card p-4 border">
              <div class="flex justify-between items-start mb-2">
                <h3 class="font-bold text-lg m-0">Display Area: <%= billboard.placement_area %></h3>
                <%= link_to "Admin Settings", edit_admin_billboard_path(billboard), class: "c-btn c-btn--sm c-btn--secondary" %>
              </div>
              <div class="text-sm mb-4 flex items-center flex-wrap gap-2">
                <span class="opacity-75">Name: <%= billboard.name %></span>
                <span class="opacity-75">&bull;</span>
                <% if billboard.approved && billboard.published %>
                  <span class="c-indicator c-indicator--success">Live (Currently Broadcasting)</span>
                <% elsif billboard.published %>
                  <span class="c-indicator c-indicator--warning">Configured to go live with event</span>
                <% else %>
                  <span class="c-indicator">Unpublished (Will not go live with event)</span>
                <% end %>
              </div>
              <div class="border rounded p-4 overflow-hidden relative break-words" style="background-color: var(--body-bg);">
                <%= billboard_body_html(billboard, billboard.processed_html_final, allow_embed_passthrough: false) %>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="opacity-75 italic">No billboards generated for this event. (Check the broadcast config or wait for the background worker to execute).</p>
      <% end %>
    </section>

    <hr class="my-8" />

    <section id="event-signups">
      <div class="flex items-center justify-between flex-wrap gap-3 mb-4">
        <h2 class="text-2xl font-bold m-0"><%= t("views.admin.events.show.signups_title") %></h2>
        <% unless ForemInstance.customerio_email_cutover? %>
          <%= link_to "Email All Signups", new_admin_email_path(event_id: @event.id), class: "c-btn c-btn--secondary c-btn--sm" %>
        <% end %>
      </div>

      <% if @event_signups.any? %>
        <div class="mb-4">
          <%= paginate @event_signups %>
        </div>
        <table class="crayons-table admin-events-table w-full">
          <thead>
            <tr>
              <th><%= t("views.admin.events.show.headers.user") %></th>
              <th><%= t("views.admin.events.show.headers.signed_up_at") %></th>
              <th><%= t("views.admin.events.show.headers.notifications") %></th>
            </tr>
          </thead>
          <tbody>
            <% @event_signups.each do |signup| %>
              <tr>
                <td>
                  <% if signup.user %>
                    <%= link_to admin_user_path(signup.user_id), class: "c-link flex items-center gap-2" do %>
                      <img class="radius-full align-middle mr-2" src="<%= signup.user.profile_image_url_for(length: 50) %>" width="30" height="30" alt="" />
                      <div>
                        <span class="font-bold"><%= signup.user.name %></span>
                        <span class="opacity-75 text-sm block">@<%= signup.user.username %></span>
                      </div>
                    <% end %>
                  <% else %>
                    <span class="opacity-50 italic">Deleted User</span>
                  <% end %>
                </td>
                <td>
                  <%= signup.created_at.to_fs(:short) %>
                </td>
                <td>
                  <div class="flex flex-wrap gap-2">
                    <% if signup.notified_1_day_before %>
                      <span class="c-indicator c-indicator--success"><%= t("views.admin.events.show.notifications.day_before") %></span>
                    <% end %>
                    <% if signup.notified_1_hour_before %>
                      <span class="c-indicator c-indicator--success"><%= t("views.admin.events.show.notifications.hour_before") %></span>
                    <% end %>
                    <% unless signup.notified_1_day_before || signup.notified_1_hour_before %>
                      <span class="opacity-75"><%= t("views.admin.events.show.notifications.none") %></span>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
        <div class="mt-4">
          <%= paginate @event_signups %>
        </div>
      <% else %>
        <p class="opacity-75 italic"><%= t("views.admin.events.show.no_signups") %></p>
      <% end %>
    </section>
  </div>
</div>

<% if @event.live_stream? %>
  <script>
    (function () {
      const toggleBtn = document.getElementById("toggle-stream-btn");
      if (toggleBtn) {
        toggleBtn.addEventListener("click", function (e) {
          e.preventDefault();

          ['feed', 'post'].forEach(function(type) {
            const overlay = document.getElementById("overlay-" + type + "-<%= @event.id %>");
            const playerContainer = document.getElementById("player-container-" + type + "-<%= @event.id %>");

            if (overlay && playerContainer) {
              if (overlay.classList.contains("hidden")) {
                overlay.classList.remove("hidden");
                playerContainer.innerHTML = "";
              } else {
                overlay.classList.add("hidden");
                if (!playerContainer.querySelector("iframe")) {
                  const iframe = document.createElement("iframe");
                  iframe.src = <%= @event.primary_stream_url.to_json.html_safe %>;
                  iframe.allowFullscreen = true;
                  playerContainer.appendChild(iframe);
                }
              }
            }
          });
        });
      }
    })();
  </script>
<% end %>

<script>
  (function () {
    document.querySelectorAll('.utc-time').forEach(el => {
      const utcTime = new Date(el.dataset.iso);
      if (isNaN(utcTime)) return;

      const localString = utcTime.toLocaleString(undefined, { weekday: 'short', year: 'numeric', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit', timeZoneName: 'short' });
      const utcString = utcTime.toUTCString();

      const diffMs = utcTime - new Date();
      const diffHours = (diffMs / (1000 * 60 * 60)).toFixed(1);
      const relativeInfo = diffHours >= 0 ? `in ${diffHours} hours` : `${Math.abs(diffHours)} hours ago`;

      const wrap = document.createElement("div");
      wrap.style.cssText = "background-color: var(--card-bg, var(--base-0)); border: 1px solid var(--base-20); border-left: 3px solid var(--accent-brand); border-radius: 6px; padding: 8px 10px; margin-top: 6px; font-size: var(--fs-xs);";

      const utcRow = document.createElement("div");
      utcRow.style.marginBottom = "2px";
      const utcStrong = document.createElement("strong");
      utcStrong.textContent = "UTC: ";
      utcRow.append(utcStrong, document.createTextNode(utcString));

      const localRow = document.createElement("div");
      localRow.style.marginBottom = "2px";
      localRow.style.color = "var(--accent-brand)";
      const localStrong = document.createElement("strong");
      localStrong.textContent = "Local: ";
      localRow.append(localStrong, document.createTextNode(localString));

      const relRow = document.createElement("div");
      relRow.className = "opacity-75";
      const relEm = document.createElement("em");
      relEm.textContent = relativeInfo;
      relRow.append(relEm);

      wrap.append(utcRow, localRow, relRow);
      el.replaceChildren(wrap);
    });

    const filterInput = document.getElementById("attach-sub-event-filter");
    const selectEl = document.getElementById("attach-sub-event-select");
    if (filterInput && selectEl) {
      const allOptions = Array.from(selectEl.options).map(opt => ({
        value: opt.value,
        text: opt.text,
        isBlank: opt.value === ""
      }));

      filterInput.addEventListener("input", function() {
        const q = filterInput.value.trim().toLowerCase();
        const currentValue = selectEl.value;
        selectEl.innerHTML = "";
        allOptions.forEach(item => {
          if (item.isBlank || !q || item.text.toLowerCase().includes(q)) {
            const option = document.createElement("option");
            option.value = item.value;
            option.textContent = item.text;
            if (item.value === currentValue) option.selected = true;
            selectEl.appendChild(option);
          }
        });
      });
    }
  })();
</script>
