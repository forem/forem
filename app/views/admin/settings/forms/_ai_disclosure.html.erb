<%= form_for(Settings::General.new,
             url: admin_settings_general_settings_path,
             html: { data: {
               action: "submit->config#updateConfigurationSettings",
               testid: "aiDisclosureForm"
             } }) do |f| %>
  <details class="crayons-card">
    <summary class="crayons-subtitle-2 p-6">AI Disclosure</summary>

    <div class="p-6 pt-0">
      <fieldset class="grid gap-4">
        <div class="crayons-field crayons-field--checkbox">
          <%= f.check_box :enable_ai_disclosure, checked: Settings::General.enable_ai_disclosure, class: "crayons-checkbox" %>
          <div class="mt-0">
            <%= admin_config_label :enable_ai_disclosure %>
            <p class="crayons-field__description">
              Enable the AI Disclosure feature, allowing authors to disclose whether a post was written without AI, with AI assistance, or fully autonomously.
            </p>
          </div>
        </div>
      </fieldset>
      <%= render "update_setting_button", f: f %>
    </div>
  </details>
<% end %>
