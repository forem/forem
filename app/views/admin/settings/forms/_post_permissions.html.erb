<%= form_for(Settings::General.new,
             url: admin_settings_general_settings_path,
             html: { data: {
               action: "submit->config#updateConfigurationSettings",
               testid: "postPermissionsForm"
             } }) do |f| %>
  <details class="crayons-card">
    <summary class="crayons-subtitle-2 p-6">Post Permissions</summary>

    <div class="p-6 pt-0">
      <fieldset class="grid gap-4">
        <div class="crayons-field crayons-field--checkbox">
          <%= f.check_box :limit_post_creation_to_admins, checked: Settings::General.limit_post_creation_to_admins, class: "crayons-checkbox" %>
          <div class="mt-0">
            <%= admin_config_label :limit_post_creation_to_admins %>
            <p class="crayons-field__description">
              Only admins can publish posts (including on behalf of an organization). Other members can only react to and comment on posts. Note: UI changes may take up to <%= pluralize(AsyncInfoController::NUMBER_OF_MINUTES_FOR_CACHE_EXPIRY, "minute") %> to take effect for all members due to caching.
            </p>
          </div>
        </div>
      </fieldset>
      <%= render "update_setting_button", f: f %>
    </div>
  </details>
<% end %>
