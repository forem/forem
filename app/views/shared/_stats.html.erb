<div class="analytics-audience-header mx-5 mt-6 mb-3">
  <% if local_assigns[:section_heading].present? %>
    <h2 class="analytics-audience-header__title"><%= section_heading %></h2>
  <% end %>
  <nav class="crayons-tabs crayons-tabs--analytics" aria-label="<%= t("views.stats.period.aria_label") %>">
    <ul class="crayons-tabs__list">
      <li>
        <button data-text="<%= t("views.stats.period.week") %>" class="crayons-tabs__item crayons-tabs__item--current" id="week-button" aria-current="page"><%= t("views.stats.period.week") %></button>
      </li>
      <li>
        <button data-text="<%= t("views.stats.period.month") %>" class="crayons-tabs__item" id="month-button"><%= t("views.stats.period.month") %></button>
      </li>
      <li>
        <button data-text="<%= t("views.stats.period.infinity") %>" class="crayons-tabs__item" id="infinity-button"><%= t("views.stats.period.infinity") %></button>
      </li>
    </ul>
  </nav>
</div>

<div class="summary-stats mx-5 mb-4">
  <div class="summary-stats__col crayons-card">
    <div id="readers-card" class="summary-stats__body"><div class="analytics-loading crayons-scaffold-loading w-75 h-0 py-4 mx-auto my-3"></div></div>
  </div>
  <div class="summary-stats__col crayons-card">
    <div id="reactions-card" class="summary-stats__body"><div class="analytics-loading crayons-scaffold-loading w-75 h-0 py-4 mx-auto my-3"></div></div>
  </div>
  <div class="summary-stats__col crayons-card">
    <div id="comments-card" class="summary-stats__body"><div class="analytics-loading crayons-scaffold-loading w-75 h-0 py-4 mx-auto my-3"></div></div>
  </div>
  <div class="summary-stats__col crayons-card">
    <div id="bookmarks-card" class="summary-stats__body"><div class="analytics-loading crayons-scaffold-loading w-75 h-0 py-4 mx-auto my-3"></div></div>
  </div>
  <% unless @article %>
    <div class="summary-stats__col crayons-card">
      <div id="followers-card" class="summary-stats__body"><div class="analytics-loading crayons-scaffold-loading w-75 h-0 py-4 mx-auto my-3"></div></div>
    </div>
  <% end %>
</div>

<div class="graphs mb-4 mx-5">
  <div class="graphs__col crayons-card p-4 m:p-5">
    <header class="analytics-card-header">
      <h2 class="analytics-card-header__title"><%= t("views.stats.readers") %></h2>
      <p class="analytics-card-header__subtitle"><%= t("views.stats.readers_description") %></p>
    </header>
    <div class="charts-container">
      <div id="readers-chart"><div class="analytics-loading crayons-scaffold-loading w-100 mx-auto" style="height:200px"></div></div>
    </div>
  </div>
</div>

<div class="graphs mb-4 mx-5">
  <div class="graphs__col crayons-card p-4 m:p-5">
    <header class="analytics-card-header">
      <h2 class="analytics-card-header__title"><%= t("views.stats.reactions") %></h2>
      <p class="analytics-card-header__subtitle">Bookmarks not included in Total</p>
    </header>
    <div class="charts-container">
      <div id="reactions-chart"><div class="analytics-loading crayons-scaffold-loading w-100 mx-auto" style="height:200px"></div></div>
    </div>
  </div>
</div>

<% if @article %>
  <div class="graphs mb-4 mx-5">
    <div class="graphs__col crayons-card p-4 m:p-5">
      <header class="analytics-card-header">
        <h2 class="analytics-card-header__title"><%= t("views.stats.comments") %></h2>
      </header>
      <div class="charts-container">
        <div id="comments-chart"><div class="analytics-loading crayons-scaffold-loading w-100 mx-auto" style="height:200px"></div></div>
      </div>
    </div>
  </div>
<% else %>
  <div class="grid xl:grid-cols-2 gap-4 mx-5 mb-4">
    <div class="graphs__col crayons-card p-4 m:p-5">
      <header class="analytics-card-header">
        <h2 class="analytics-card-header__title"><%= t("views.stats.comments") %></h2>
      </header>
      <div class="charts-container">
        <div id="comments-chart"><div class="analytics-loading crayons-scaffold-loading w-100 mx-auto" style="height:200px"></div></div>
      </div>
    </div>
    <div class="graphs__col crayons-card p-4 m:p-5">
      <header class="analytics-card-header">
        <h2 class="analytics-card-header__title"><%= t("views.stats.followers") %></h2>
      </header>
      <div class="charts-container">
        <div id="followers-chart"><div class="analytics-loading crayons-scaffold-loading w-100 mx-auto" style="height:200px"></div></div>
      </div>
    </div>
  </div>
<% end %>

<% if @reactions && @reactions.any? %>
  <div class="grid xl:grid-cols-2 gap-4 mx-5 mb-6">
    <div class="crayons-card p-4 m:p-5 overflow-auto" style="max-height:600px">
      <header class="analytics-card-header">
        <h2 class="analytics-card-header__title"><%= t("views.stats.traffic.text") %></h2>
      </header>
      <div id="referrers-chart"><div class="analytics-loading crayons-scaffold-loading w-100 mx-auto" style="height:150px"></div></div>
      <table class="w-100 m-auto crayons-table">
        <thead>
          <tr>
            <th class="align-left"><%= t("views.stats.traffic.source") %></th>
            <th class="align-right"><%= t("views.stats.traffic.views") %></th>
          </tr>
        </thead>
        <tbody id="referrers-container"></tbody>
      </table>
    </div>
    <div class="crayons-card p-4 m:p-5 overflow-auto" style="max-height:600px">
      <header class="analytics-card-header">
        <h2 class="analytics-card-header__title">
          <%= t("views.stats.reactions_history") %>
        </h2>
      </header>
      <% @reactions.each do |reaction| %>
        <div class="fs-sm py-2 flex items-center">
          <div class="mr-3 relative">
            <img class="crayons-avatar h-8 w-8" style="height: 30px; width: 30px;" src="<%= reaction.user.profile_image_90 %>" width="25" height="25">
            <img class="crayons-avatar absolute -right-1 -bottom-1 border-base-inverted" style="height: 20px; width: 20px;" src="/assets/<%= reaction.reaction_category.icon %>.svg" width="16" height="16">
          </div>
          <div class="flex-1 flex items-center justify-between">
            <div>
              <strong><%= reaction.category %></strong>
              <%= t("views.stats.by") %> <a href="<%= URL.user(reaction.user) %>" class="fw-bold"><%= reaction.user.name %></a>
            </div>
            <div class="fs-xs">
              <%= reaction.readable_date %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
<% else %>
  <div class="grid xl:grid-cols-2 gap-4 mx-5 mb-6">
    <div class="crayons-card p-4 m:p-5 overflow-auto" style="max-height:600px">
      <header class="analytics-card-header">
        <h2 class="analytics-card-header__title"><%= t("views.stats.traffic.text") %></h2>
      </header>
      <div id="referrers-chart"><div class="analytics-loading crayons-scaffold-loading w-100 mx-auto" style="height:150px"></div></div>
      <table class="w-100 m-auto crayons-table">
        <thead>
          <tr>
            <th class="align-left"><%= t("views.stats.traffic.source") %></th>
            <th class="align-right"><%= t("views.stats.traffic.views") %></th>
          </tr>
        </thead>
        <tbody id="referrers-container"></tbody>
      </table>
    </div>
    <% unless @article %>
      <div class="crayons-card p-4 m:p-5 overflow-auto" style="max-height:600px">
        <header class="analytics-card-header">
          <h2 class="analytics-card-header__title"><%= t("views.stats.top_contributors.heading") %></h2>
        </header>
        <div id="top-contributors-container">
          <div class="analytics-loading crayons-scaffold-loading w-100 mx-auto" style="height:150px"></div>
        </div>
      </div>
    <% end %>
  </div>
<% end %>
