<% title t("org_domain_membership.join_title", organization: @organization.name) %>
<main class="crayons-layout crayons-layout--limited-s p-4">
  <div class="crayons-card p-6 grid gap-4">
    <h1 class="crayons-title"><%= t("org_domain_membership.join_title", organization: @organization.name) %></h1>
    <% if flash[:notice] %><p class="crayons-notice" role="status"><%= flash[:notice] %></p><% end %>
    <% if flash[:alert] %><p class="crayons-notice crayons-notice--danger" role="alert"><%= flash[:alert] %></p><% end %>
    <% if @membership && !@membership.pending? %>
      <p><%= t("org_domain_membership.errors.already_member") %></p>
      <%= link_to @organization.name, @organization.path, class: "crayons-btn" %>
    <% elsif @organization.organization_email_domains.available.exists? %>
      <p><%= t("org_domain_membership.join_description", username: current_user.username) %></p>
      <p><%= t("org_domain_membership.permissions") %></p>
      <p><%= t("org_domain_membership.eligible_domains", domains: @organization.organization_email_domains.available.pluck(:domain).join(", ")) %></p>
      <% if @challenge %>
        <%= form_with url: organization_join_path(@organization.slug), method: :patch, local: true, class: "grid gap-4" do %>
          <%= hidden_field_tag :challenge_id, @challenge.id %>
          <div class="crayons-field">
            <%= label_tag :otp, t("org_domain_membership.code"), class: "crayons-field__label" %>
            <%= text_field_tag :otp, nil, required: true, inputmode: "numeric", pattern: "[0-9]{8}", maxlength: 8, autocomplete: "one-time-code", class: "crayons-textfield" %>
          </div>
          <%= submit_tag t("org_domain_membership.verify_join"), class: "crayons-btn" %>
        <% end %>
      <% end %>
      <%= form_with url: organization_join_path(@organization.slug), method: :post, local: true, class: "grid gap-4" do %>
        <div class="crayons-field">
          <%= label_tag :work_email, t("org_domain_membership.work_email"), class: "crayons-field__label" %>
          <%= email_field_tag :work_email, nil, required: true, maxlength: 254, autocomplete: "email", class: "crayons-textfield" %>
          <p class="crayons-field__description"><%= t("org_domain_membership.email_private") %></p>
        </div>
        <%= submit_tag t(@challenge ? "org_domain_membership.resend" : "org_domain_membership.send_code"), class: "crayons-btn crayons-btn--secondary" %>
      <% end %>
    <% else %>
      <p><%= t("org_domain_membership.errors.unavailable") %></p>
    <% end %>
  </div>
</main>
