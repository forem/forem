<%- if local_assigns[:in_article] && local_assigns[:attribution].present? -%>
<%- enter_label = I18n.t("services.html.parser.enter_fullscreen_mode") -%>
<%- exit_label = I18n.t("services.html.parser.exit_fullscreen_mode") -%>
<div class="ltag__page ltag__page--article<%= local_assigns[:frameless] ? " ltag__page--frameless" : "" %> js-page-embed">
  <div class="ltag__page-card">
    <div class="ltag__page-viewport">
      <%- if local_assigns[:sandboxed] -%>
      <iframe src="<%= url %>" title="<%= title %>" width="100%" height="<%= height %>" frameborder="0" loading="lazy" sandbox="<%= PageTag::IFRAME_SANDBOX %>" credentialless referrerpolicy="no-referrer" allow="<%= PageTag::IFRAME_ALLOW_POLICY %>" style="<%= style %>"></iframe>
      <%- else -%>
      <iframe src="<%= url %>" title="<%= title %>" width="100%" height="<%= height %>" frameborder="0" loading="lazy" allowfullscreen style="<%= style %>"></iframe>
      <%- end -%>
    </div>
    <div class="ltag__page-footer">
      <div class="ltag__page-meta">
        <a href="<%= attribution[:owner_path] %>" class="ltag__page-owner-avatar-link" aria-hidden="true" tabindex="-1">
          <%- if attribution[:owner_avatar_url].present? -%>
          <img src="<%= attribution[:owner_avatar_url] %>" alt="" width="24" height="24" loading="lazy" data-ignore-prefix="true" class="ltag__page-avatar ltag__page-avatar--<%= attribution[:owner_type] %>">
          <%- else -%>
          <span class="ltag__page-avatar ltag__page-avatar--fallback"><svg width="14" height="14" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6zm4 18H6V4h7v5h5v11z"/></svg></span>
          <%- end -%>
        </a>
        <div class="ltag__page-info">
          <%- if attribution[:canonical_url].present? -%>
          <a href="<%= attribution[:canonical_url] %>" class="ltag__page-title"><%= title %></a>
          <%- else -%>
          <span class="ltag__page-title"><%= title %></span>
          <%- end -%>
          <span class="ltag__page-separator" aria-hidden="true">&middot;</span>
          <a href="<%= attribution[:owner_path] %>" class="ltag__page-owner-link"><%= attribution[:owner_name] %></a>
        </div>
      </div>
      <button type="button" class="ltag__page-fullscreen-btn js-fullscreen-page-action" aria-expanded="false" aria-label="<%= enter_label %>" title="<%= enter_label %>" data-enter-label="<%= enter_label %>" data-exit-label="<%= exit_label %>"><svg class="ltag__page-fullscreen-icon ltag__page-fullscreen-icon--on" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M16 3h6v6h-2V5h-4V3zM2 3h6v2H4v4H2V3zm18 16v-4h2v6h-6v-2h4zM4 19h4v2H2v-6h2v4z"/></svg><svg class="ltag__page-fullscreen-icon ltag__page-fullscreen-icon--off" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M18 7h4v2h-6V3h2v4zM8 9H2V7h4V3h2v6zm10 8v4h-2v-6h6v2h-4zM8 15v6H6v-4H2v-2h6z"/></svg></button>
    </div>
  </div>
</div>
<%- else -%>
<div class="ltag__page">
  <%- if local_assigns[:sandboxed] -%>
  <iframe src="<%= url %>" title="<%= title %>" width="100%" height="<%= height %>" frameborder="0" loading="lazy" sandbox="<%= PageTag::IFRAME_SANDBOX %>" credentialless referrerpolicy="no-referrer" allow="<%= PageTag::IFRAME_ALLOW_POLICY %>" style="<%= style %>"></iframe>
  <%- else -%>
  <iframe src="<%= url %>" title="<%= title %>" width="100%" height="<%= height %>" frameborder="0" loading="lazy" allowfullscreen style="<%= style %>"></iframe>
  <%- end -%>
</div>
<%- end -%>
