<div class="ltag__page">
  <iframe
    src="<%= url %>"
    title="<%= title %>"
    width="100%"
    height="<%= height %>"
    frameborder="0"
    loading="lazy"
    allowfullscreen
    style="width: 100%; border: 1px solid var(--card-border, #e1e5e9); border-radius: var(--radius-auto, 6px); background: var(--card-bg, #fff);">
  </iframe>
</div>
