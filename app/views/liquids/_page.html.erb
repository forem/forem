<div class="ltag__page">
  <% if local_assigns[:sandboxed] %>
    <iframe
      src="<%= url %>"
      title="<%= title %>"
      width="100%"
      height="<%= height %>"
      frameborder="0"
      loading="lazy"
      sandbox="<%= PageTag::IFRAME_SANDBOX %>"
      credentialless
      referrerpolicy="no-referrer"
      allow="<%= PageTag::IFRAME_ALLOW_POLICY %>"
      style="width: 100%; border: 1px solid var(--card-border, #e1e5e9); border-radius: var(--radius-auto, 6px); background: var(--card-bg, #fff);">
    </iframe>
  <% else %>
    <iframe
      src="<%= url %>"
      title="<%= title %>"
      width="100%"
      height="<%= height %>"
      frameborder="0"
      loading="lazy"
      allowfullscreen
      style="width: 100%; border: 1px solid var(--card-border, #e1e5e9); border-radius: var(--radius-auto, 6px); background: var(--card-bg, #fff);">
    </iframe>
  <% end %>
</div>
