<div class="crayons-card c-embed text-styles text-styles--secondary">
  <% safe_url = url.to_s.match?(%r{\Ahttps?://}i) ? url : "#" %>
  <% if page.main_properties_present? %>
    <% safe_page_url = page.respond_to?(:url) && page.url.to_s.match?(%r{\Ahttps?://}i) ? page.url : safe_url %>
    <div class="c-embed__content">
      <% if page.image %>
        <div class="c-embed__cover">
          <a href="<%= safe_page_url %>" class="c-link align-middle" target="_blank" rel="noopener noreferrer">
            <img alt="" src="<%= page.image %>" height="auto" loading="lazy" class="m-0">
          </a>
        </div>
      <% end %>
      <div class="c-embed__body">
        <h2 class="fs-xl lh-tight">
          <a href="<%= safe_page_url %>" target="_blank" rel="noopener noreferrer" class="c-link">
            <%= page.title %>
          </a>
        </h2>
        <% if page.description %>
          <p class="truncate-at-3">
            <%= page.preferred_desc %>
          </p>
        <% end %>
        <div class="color-secondary fs-s flex items-center">
          <% if page.images.favicon %>
            <img
              alt="favicon"
              class="c-embed__favicon m-0 mr-2 radius-0"
              src="<%= page.images.favicon %>"
              loading="lazy" />
          <% end %>
          <%= url_domain %>
        </div>
      </div>
    </div>
  <% else %>
    <div class="c-embed__content">
      <div class="c-embed__body flex items-center justify-between">
        <a href="<%= safe_url %>" target="_blank" rel="noopener noreferrer" class="c-link fw-bold flex items-center">
          <span class="mr-2"><%= url_domain %></span>
          <%= crayons_icon_tag("external-link", class: "crayons-icon--l", aria_hidden: true, height: 40, width: 40) %>
        </a>
      </div>
    </div>
  <% end %>
</div>
