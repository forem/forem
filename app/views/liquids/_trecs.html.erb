<div class="ltag_trecs" style="position: relative; width: 100%; height: 520px;">
  <iframe
    src="https://trecs.run/embed/<%= id %><%= "?t=#{start}" if start.present? %>"
    title="trecs terminal recording"
    width="100%"
    height="520"
    frameborder="0"
    loading="lazy"
    allowfullscreen
    style="position: absolute; top: 0; left: 0; width: 100%; height: 100%;">
  </iframe>
</div>
