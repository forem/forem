<div class="ai-chat-container">
  <% unless local_assigns[:hide_header] %>
    <div class="ai-chat-header">
      <div class="bot-icon">🤖</div>
      <h1><%= title || "AI Community Buddy" %> <span class="beta-badge">BETA</span></h1>
    </div>
  <% end %>

  <div id="ai-chat-messages" class="ai-chat-messages">
    <div class="message ai">
      <%= greeting || "Hello! I'm your community buddy. I see you've been exploring some interesting topics lately. How can I help you today?" %>
    </div>
  </div>

  <form id="ai-chat-form" class="ai-chat-input-area" data-chat-context="<%= chat_context || 'community' %>">
    <input type="text" id="ai-chat-input" class="ai-chat-input" placeholder="Type your message..." autocomplete="off">
    <button type="submit" id="ai-chat-send" class="ai-chat-send">Send</button>
  </form>
</div>

<%= javascript_tag do %>
  (function() {
    const form = document.getElementById('ai-chat-form');
    const input = document.getElementById('ai-chat-input');
    const messagesContainer = document.getElementById('ai-chat-messages');
    const sendButton = document.getElementById('ai-chat-send');
    const chatContext = form.dataset.chatContext;
    
    let chatHistory = [];

    function appendMessage(role, content, isHtml = false) {
      const msgDiv = document.createElement('div');
      msgDiv.className = `message ${role}`;
      
      if (isHtml) {
        msgDiv.innerHTML = content;
      } else {
        msgDiv.innerText = content;
      }
      
      messagesContainer.appendChild(msgDiv);
      messagesContainer.scrollTop = messagesContainer.scrollHeight;
      return msgDiv;
    }

    function showTypingIndicator() {
      const indicator = document.createElement('div');
      indicator.className = 'message ai typing';
      indicator.innerHTML = '<div class="typing-indicator"><span></span><span></span><span></span></div>';
      messagesContainer.appendChild(indicator);
      messagesContainer.scrollTop = messagesContainer.scrollHeight;
      return indicator;
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const message = input.value.trim();
      if (!message) return;

      input.value = '';
      input.disabled = true;
      sendButton.disabled = true;

      appendMessage('user', message);
      const indicator = showTypingIndicator();

      try {
        let payload = { message, history: chatHistory, chat_context: chatContext };
        
        if (chatContext === 'editor') {
          const liveState = window.__foremEditorState || {};
          const titleInput = document.getElementById('article-form-title');
          const bodyInput = document.getElementById('article_body_markdown');
          const containerEl =
            document.getElementById('main-content') ||
            document.getElementById('article-form-container');
          const domErrors = Array.from(
            document.querySelectorAll('[data-testid="error-message"] li, [data-testid="error-message"]')
          )
            .map((el) => el.textContent.trim())
            .filter(Boolean);

          const title = titleInput ? titleInput.value : (liveState.title || '');
          const body = bodyInput ? bodyInput.value : (liveState.body || '');

          payload.article_state = {
            ...liveState,
            title,
            body,
            version: liveState.version || containerEl?.dataset?.version || undefined,
            errors: liveState.errors || (domErrors.length > 0 ? domErrors : null)
          };
        }

        const response = await fetch('/ai_chats', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content
          },
          body: JSON.stringify(payload)
        });

        let data = null;
        const contentType = response.headers.get('content-type') || '';
        if (contentType.includes('application/json')) {
          data = await response.json();
        } else if (response.status === 429) {
          data = { error: 'Rate limit reached. Please wait a moment and try again.' };
        } else {
          data = { error: 'Something went wrong. Please try again.' };
        }
        indicator.remove();

        if (data.error) {
          appendMessage('ai', 'Error: ' + data.error);
        } else {
          appendMessage('ai', data.message, true);
          chatHistory = data.history;
        }
      } catch (err) {
        indicator.remove();
        appendMessage('ai', 'Error: Failed to connect to server.');
      } finally {
        input.disabled = false;
        sendButton.disabled = false;
        input.focus();
      }
    });
  })();
<% end %>
