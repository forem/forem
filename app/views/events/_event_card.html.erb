<%
  host = event.organization || event.user
  sub_summary = defined?(@sub_event_summaries) ? @sub_event_summaries&.[](event.id) : nil
  parent_list = defined?(@parent_events_by_child_id) ? Array(@parent_events_by_child_id&.[](event.id)) : []
  is_live = event.live?
  has_live_sub = sub_summary && sub_summary[:live_count].to_i.positive?
  card_image_url = event_card_image_url(event, width: 640)
%>
<a href="<%= event_link_target(event) %>" class="event-card">
  <div class="event-card-banner" <% unless card_image_url.present? %>style="background: <%= event.gradient_background_css %>;"<% end %>>
    <% if card_image_url.present? %>
      <img src="<%= card_image_url %>" alt="<%= event.title %> Cover" loading="lazy" />
    <% end %>
    <% if is_live || has_live_sub %>
      <span class="event-card-live-badge">
        <span class="event-status-badge__dot" aria-hidden="true"></span>
        <%= t("views.events.gathering.live") %>
      </span>
    <% end %>
  </div>

  <div class="event-card-body">
    <div>
      <% if parent_list.any? %>
        <div class="event-card-parent-chip mb-2">
          <%= t("views.events.hierarchy.part_of_inline", title: parent_list.first.title) %>
        </div>
      <% end %>

      <h2 class="event-card-title mb-3">
        <%= event.title %>
      </h2>

      <div class="event-card-meta">
        <div class="meta-item">
          <svg class="c-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
            <line x1="16" y1="2" x2="16" y2="6"></line>
            <line x1="8" y1="2" x2="8" y2="6"></line>
            <line x1="3" y1="10" x2="21" y2="10"></line>
          </svg>
          <span><%= event.formatted_date_range %></span>
        </div>

        <div class="meta-item">
          <svg class="c-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
            <circle cx="12" cy="10" r="3"></circle>
          </svg>
          <span><%= event.location_display %></span>
        </div>

        <% if host.present? %>
          <div class="meta-item">
            <svg class="c-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
              <circle cx="9" cy="7" r="4"></circle>
              <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
              <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
            </svg>
            <span><%= host.name %></span>
          </div>
        <% end %>
      </div>

      <% if has_live_sub && sub_summary[:live_title].present? %>
        <div class="event-card-live-session mt-3">
          <span class="event-card-live-session__label"><%= t("views.events.hierarchy.live_now_inline") %>:</span>
          <span class="event-card-live-session__title"><%= truncate(sub_summary[:live_title], length: 48) %></span>
        </div>
      <% end %>
    </div>

    <div class="event-card-footer flex items-center justify-between flex-wrap gap-2">
      <div class="flex items-center flex-wrap gap-1">
        <span class="event-pill <%= event_pill_class(event) %>"><%= event.format_pill_label %></span>
        <% if sub_summary && sub_summary[:total_count].to_i.positive? %>
          <span class="event-card-sessions-pill">
            <%= t("views.events.hierarchy.sessions_count", count: sub_summary[:total_count]) %>
          </span>
        <% end %>
      </div>
      <% if is_live %>
        <span class="c-indicator c-indicator--danger fw-bold fs-xs"><%= t("views.events.gathering.live") %></span>
      <% end %>
    </div>
  </div>
</a>
