<%
  signed_up = if local_assigns.key?(:signed_up)
                local_assigns[:signed_up]
              elsif defined?(@signed_up_event_ids) && @signed_up_event_ids
                @signed_up_event_ids.include?(event.id)
              else
                current_user.present? && current_user.event_signups.exists?(event: event)
              end
  signed_up_class = local_assigns[:signed_up_class] || "crayons-btn--outlined"
  unsigned_up_class = local_assigns[:unsigned_up_class] || "crayons-btn--primary"
%>
<button data-event-signup-button="true"
        data-event-name-slug="<%= event.event_name_slug %>"
        data-event-variation-slug="<%= event.event_variation_slug %>"
        data-signup-confirm-message="<%= event.signup_confirm_message %>"
        data-signed-up-class="<%= signed_up_class %>"
        data-unsigned-up-class="<%= unsigned_up_class %>"
        class="crayons-btn event-signup-btn <%= local_assigns[:extra_classes] %> <%= signed_up ? signed_up_class : unsigned_up_class %>"
        data-signed-up="<%= signed_up ? 'true' : 'false' %>"
        aria-pressed="<%= signed_up ? 'true' : 'false' %>">
  <template data-signed-up-html>
    <svg class="c-icon mr-1" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
    <%= event.signup_button_text(signed_up: true) %>
  </template>
  <template data-unsigned-up-html>
    <%= event.signup_button_text(signed_up: false) %>
  </template>

  <% if signed_up %>
    <svg class="c-icon mr-1" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
    <%= event.signup_button_text(signed_up: true) %>
  <% else %>
    <%= event.signup_button_text(signed_up: false) %>
  <% end %>
</button>
