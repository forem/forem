<%
  child = membership.child_event
  host = child.organization || child.user
  duration = event_duration_label(child)
  row_classes = ["event-session-card"]
  row_classes << "event-session-card--live" if state == :live
  row_classes << "event-session-card--past" if state == :past
  row_classes << "event-session-card--featured" if membership.featured?
%>
<article class="<%= row_classes.join(' ') %>"
         data-session-row="true"
         data-session-role="<%= membership.role.to_s.downcase %>">
  <div class="event-session-card__accent" style="background: <%= child.background_hex_color %>;" aria-hidden="true"></div>

  <div class="event-session-card__time-col">
    <div class="event-session-card__clock">
      <time class="js-event-local-time"
            datetime="<%= child.start_time.iso8601 %>"
            data-start-iso="<%= child.start_time.iso8601 %>"
            data-end-iso="<%= child.end_time.iso8601 %>"
            data-format="time_only">
        <%= event_time_slot_label(child, time_zone: parent_event.time_zone) %>
      </time>
    </div>
    <% if duration.present? %>
      <div class="event-session-card__duration"><%= duration %></div>
    <% end %>
    <div class="mt-2">
      <% if state == :live %>
        <span class="event-status-badge event-status-badge--live event-status-badge--xs">
          <span class="event-status-badge__dot" aria-hidden="true"></span>
          <%= t("views.events.gathering.live") %>
        </span>
      <% elsif state == :upcoming %>
        <span class="event-status-badge event-status-badge--upcoming-subtle event-status-badge--xs">
          <%= t("views.events.gathering.upcoming") %>
        </span>
      <% else %>
        <span class="event-status-badge event-status-badge--ended event-status-badge--xs">
          <%= child.primary_stream_url.present? ? t("views.events.stream.replay_short") : t("views.events.gathering.ended") %>
        </span>
      <% end %>
    </div>
  </div>

  <div class="event-session-card__body">
    <div class="event-session-card__badges">
      <span class="event-pill <%= event_pill_class(child) %>"><%= child.format_pill_label %></span>
      <% if membership.role.present? %>
        <span class="event-role-chip"><%= membership.role %></span>
      <% end %>
      <% if membership.featured? %>
        <span class="event-featured-chip">★ <%= t("views.events.hierarchy.featured") %></span>
      <% end %>
      <% unless child.published? %>
        <span class="event-draft-chip"><%= t("views.events.hierarchy.draft") %></span>
      <% end %>
    </div>

    <h4 class="event-session-card__title">
      <a href="<%= event_link_target(child) %>"><%= child.title %></a>
    </h4>

    <% if child.description.present? %>
      <p class="event-session-card__desc"><%= truncate(child.description, length: 180) %></p>
    <% end %>

    <% if host.present? %>
      <div class="event-session-card__host">
        <span><%= host.name %></span>
      </div>
    <% end %>
  </div>

  <div class="event-session-card__actions">
    <% if state == :live %>
      <a href="<%= event_link_target(child) %>" class="crayons-btn crayons-btn--primary event-session-card__cta">
        <%= child.primary_stream_url.present? ? t("views.events.hierarchy.watch_live") : t("views.events.hierarchy.join_session") %>
      </a>
    <% elsif state == :upcoming %>
      <%= render "signup_button",
                 event: child,
                 extra_classes: "event-session-card__cta" %>
      <a href="<%= event_link_target(child) %>" class="crayons-btn crayons-btn--secondary event-session-card__cta">
        <%= t("views.events.hierarchy.details") %>
      </a>
    <% else %>
      <a href="<%= event_link_target(child) %>" class="crayons-btn crayons-btn--outlined event-session-card__cta">
        <%= child.primary_stream_url.present? ? t("views.events.hierarchy.watch_replay") : t("views.events.hierarchy.recap") %>
      </a>
    <% end %>
  </div>
</article>
