<% content_for :title, @event.title %>
<%= content_for :page_meta do %>
  <link rel="canonical" href="<%= app_url(event_path(@event.event_name_slug, @event.event_variation_slug)) %>" />
  <meta name="description" content="<%= @event.description %>">
  <meta property="og:title" content="<%= @event.title %>" />
  <meta property="og:description" content="<%= @event.description %>" />
  <meta property="og:url" content="<%= app_url(event_path(@event.event_name_slug, @event.event_variation_slug)) %>" />
  <meta property="og:type" content="event" />
  <meta property="og:image" content="<%= @event.social_image_url %>" />
  <meta name="twitter:image:src" content="<%= @event.social_image_url %>">
  <meta name="twitter:card" content="summary_large_image">
<% end %>
<%
  type_key = @event.meetup? ? "meetups" : "conferences"
  type_landing_path = @event.meetup? ? meetups_path : conferences_path
  banner_1x = event_banner_image_url(@event, width: 1600)
  banner_2x = event_banner_image_url(@event, width: 3200)
  now = Time.current
  external_url = safe_event_url(@event.data&.dig("registration_url") || @event.data&.dig("website_url"))
  external_cta_label = @event.data&.dig("registration_url").present? ? t("views.events.gathering.register_external") : t("views.events.gathering.visit_website")
  host = @event.organization || @event.user
  host_path = event_host_path(@event)
  schedule = @sub_event_schedule
%>

<%= render "event_tabs" %>

<div class="event-brand-shell" style="--event-brand-color: <%= @event.background_hex_color %>;">
  <% if banner_1x.present? %>
    <div class="event-brand-cover">
      <img src="<%= banner_1x %>"
           <% if banner_2x.present? && banner_2x != banner_1x %>srcset="<%= banner_1x %> 1x, <%= banner_2x %> 2x"<% end %>
           alt="<%= @event.title %>">
    </div>
  <% end %>
  <div class="event-brand-line" aria-hidden="true"></div>
</div>

<div class="event-show-layout event-page-container">
  <% if !@event.published? %>
    <div class="crayons-notice crayons-notice--warning mb-5 p-3 fs-s text-center">
      <strong><%= t("views.events.draft_notice.heading") %></strong> <%= t("views.events.draft_notice.body") %>
      <a href="<%= edit_admin_event_path(@event) %>" class="c-link c-link--branded ml-2"><%= t("views.events.draft_notice.edit") %></a>
    </div>
  <% end %>

  <%= render "parent_context_bar" %>

  <header class="event-profile-header mb-6">
    <nav aria-label="Breadcrumbs" class="event-breadcrumbs mb-2 fs-xs color-base-60">
      <a href="<%= events_path %>" class="event-breadcrumbs__link"><%= t("views.events.gathering.events") %></a>
      <span aria-hidden="true">/</span>
      <a href="<%= type_landing_path %>" class="event-breadcrumbs__link"><%= t("views.events.gathering.#{type_key}") %></a>
    </nav>

    <div class="event-profile-header__row">
      <div class="event-profile-header__main">
        <div class="event-profile-header__title-row">
          <h1 class="event-profile-header__title"><%= @event.title %></h1>
          <% if @event.start_time > now %>
            <span class="event-status-badge event-status-badge--upcoming-subtle event-status-badge--xs"><%= t("views.events.gathering.upcoming") %></span>
          <% elsif @event.end_time >= now && !schedule&.live? %>
            <span class="live-indicator event-status-badge event-status-badge--live event-status-badge--xs">
              <span class="event-status-badge__dot" aria-hidden="true"></span>
              <%= t("views.events.gathering.live") %>
            </span>
          <% elsif @event.end_time < now %>
            <span class="event-status-badge event-status-badge--ended event-status-badge--xs"><%= t("views.events.gathering.ended") %></span>
          <% end %>
        </div>

        <% if @event.description.present? %>
          <p class="event-profile-header__lead"><%= @event.description %></p>
        <% end %>

        <div class="event-stage-header__meta mt-3">
          <span class="event-meta-chip">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
              <line x1="16" y1="2" x2="16" y2="6"></line>
              <line x1="8" y1="2" x2="8" y2="6"></line>
              <line x1="3" y1="10" x2="21" y2="10"></line>
            </svg>
            <time class="js-event-local-time"
                  datetime="<%= @event.start_time.iso8601 %>"
                  data-start-iso="<%= @event.start_time.iso8601 %>"
                  data-end-iso="<%= @event.end_time.iso8601 %>">
              <%= event_datetime_range(@event) %>
            </time>
          </span>
          <span class="event-meta-chip">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
              <circle cx="12" cy="10" r="3"></circle>
            </svg>
            <%= @event.location_display %>
          </span>
          <% if host.present? %>
            <span class="event-meta-chip">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                <circle cx="9" cy="7" r="4"></circle>
              </svg>
              <% if host_path.present? %>
                <a href="<%= host_path %>" class="event-meta-chip__link"><%= host.name %></a>
              <% else %>
                <%= host.name %>
              <% end %>
            </span>
          <% end %>
        </div>
      </div>

      <div class="event-profile-header__actions">
        <% if @event.end_time > now %>
          <%= render "signup_button", event: @event %>
        <% end %>

        <% if external_url.present? %>
          <a href="<%= external_url %>" target="_blank" rel="noopener noreferrer" class="crayons-btn crayons-btn--outlined whitespace-nowrap">
            <%= external_cta_label %>
          </a>
        <% end %>

        <button type="button"
                class="crayons-btn crayons-btn--secondary js-copy-event-link whitespace-nowrap"
                data-copy-url="<%= app_url(event_path(@event.event_name_slug, @event.event_variation_slug)) %>"
                data-copied-text="<%= t("views.events.stream.link_copied") %>">
          <svg class="c-icon mr-1" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="18" cy="5" r="3"></circle>
            <circle cx="6" cy="12" r="3"></circle>
            <circle cx="18" cy="19" r="3"></circle>
            <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
            <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
          </svg>
          <span data-copy-label><%= t("views.events.stream.share") %></span>
        </button>
      </div>
    </div>
  </header>

  <%= render "sub_events_hero", event: @event, schedule: schedule %>

  <div class="event-detail-columns">
    <main class="event-detail-columns__main" id="main-content">
      <% if @event.primary_stream_url.present? %>
        <div class="mb-6">
          <%= render "stream_player", event: @event %>
        </div>
      <% end %>

      <%= render "sub_events_schedule", event: @event, schedule: schedule %>

      <article class="crayons-card event-body-card mb-6">
        <h2 class="event-section-label"><%= t("views.events.gathering.about_heading") %></h2>
        <div class="crayons-article__body text-styles">
          <%= @event.body_html %>
        </div>
      </article>

      <%= render "event_articles", articles: @event_articles, event: @event, previews: @event_article_previews %>

      <%= render "community_articles", articles: @articles, tag_name: @tag_name %>
    </main>

    <aside class="event-detail-columns__aside">
      <div class="crayons-card p-5 mb-5">
        <% if @event.end_time > now %>
          <div class="event-sidebar-block">
            <h3 class="event-sidebar-heading mb-1"><%= t("views.events.gathering.register_heading") %></h3>
            <p class="fs-s color-base-60 mb-3 mt-0"><%= t("views.events.gathering.register_description") %></p>
            <%= render "signup_button", event: @event, extra_classes: "w-100 text-center justify-center" %>
            <a href="<%= event_google_calendar_url(@event) %>"
               target="_blank"
               rel="noopener noreferrer"
               class="crayons-btn crayons-btn--secondary w-100 text-center justify-center mt-2">
              <%= t("views.events.stream.add_to_calendar") %>
            </a>
          </div>
        <% end %>

        <div class="<%= 'event-sidebar-block event-sidebar-block--divided' if @event.end_time > now %>">
          <h3 class="event-sidebar-heading"><%= t("views.events.gathering.details") %></h3>
          <ul class="event-details-list">
            <li>
              <span class="event-details-list__label"><%= t("views.events.gathering.dates") %></span>
              <span class="event-details-list__value">
                <time class="js-event-local-time"
                      datetime="<%= @event.start_time.iso8601 %>"
                      data-start-iso="<%= @event.start_time.iso8601 %>"
                      data-end-iso="<%= @event.end_time.iso8601 %>">
                  <%= event_datetime_range(@event) %>
                </time>
              </span>
            </li>
            <li>
              <span class="event-details-list__label"><%= t("views.events.gathering.location") %></span>
              <span class="event-details-list__value"><%= @event.location_display %></span>
            </li>
            <li>
              <span class="event-details-list__label"><%= t("views.events.gathering.format") %></span>
              <span class="event-details-list__value"><%= @event.format_pill_label %></span>
            </li>
            <% if host.present? %>
              <li>
                <span class="event-details-list__label"><%= t("views.events.gathering.host") %></span>
                <span class="event-details-list__value">
                  <% if host_path.present? %>
                    <a href="<%= host_path %>" class="c-link c-link--branded fw-medium"><%= host.name %></a>
                  <% else %>
                    <%= host.name %>
                  <% end %>
                </span>
              </li>
            <% end %>
          </ul>

          <% if external_url.present? %>
            <div class="mt-4 pt-4 border-t">
              <a href="<%= external_url %>" target="_blank" rel="noopener noreferrer" class="crayons-btn crayons-btn--outlined w-100 text-center justify-center">
                <%= external_cta_label %>
              </a>
            </div>
          <% end %>
        </div>
      </div>
    </aside>
  </div>

  <%= render "local_time_script" %>
</div>
