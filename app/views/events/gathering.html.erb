<% content_for :title, @event.title %>
<%= content_for :page_meta do %>
  <link rel="canonical" href="<%= app_url(event_path(@event.event_name_slug, @event.event_variation_slug)) %>" />
  <meta name="description" content="<%= @event.description %>">
  <meta property="og:title" content="<%= @event.title %>" />
  <meta property="og:description" content="<%= @event.description %>" />
  <meta property="og:url" content="<%= app_url(event_path(@event.event_name_slug, @event.event_variation_slug)) %>" />
  <meta property="og:type" content="event" />
  <meta property="og:image" content="<%= @event.social_image_url %>" />
  <meta name="twitter:image:src" content="<%= @event.social_image_url %>">
  <meta name="twitter:card" content="summary_large_image">
<% end %>
<%
  type_key = @event.meetup? ? "meetups" : "conferences"
  type_landing_path = @event.meetup? ? meetups_path : conferences_path
  banner_image = @event.cover_image.presence&.url || @event.data&.dig("banner_image_url")
  safe_banner = safe_event_url(banner_image)
  now = Time.current
  external_url = safe_event_url(@event.data&.dig("registration_url") || @event.data&.dig("website_url"))
  external_cta_label = @event.data&.dig("registration_url").present? ? t("views.events.gathering.register_external") : t("views.events.gathering.visit_website")
  host = @event.organization || @event.user
  schedule = @sub_event_schedule
%>
<div class="crayons-layout event-show-layout container grid-cols-1">
  <% if !@event.published? %>
    <div class="crayons-notice crayons-notice--warning mb-6 p-4 text-center">
      <strong>This event is not published!</strong> Only admins can see this page.
      <a href="<%= edit_admin_event_path(@event) %>" class="c-link c-link--branded ml-2">Edit Event</a>
    </div>
  <% end %>

  <%= render "parent_context_bar" %>

  <header class="event-gathering-hero crayons-card mb-6 overflow-hidden">
    <% if safe_banner.present? %>
      <div class="event-gathering-hero__banner">
        <img src="<%= safe_banner %>" alt="<%= @event.title %>" class="w-100">
      </div>
    <% else %>
      <div class="event-gathering-hero__banner event-gathering-hero__banner--gradient" style="background: <%= @event.gradient_background_css %>;">
        <div class="event-gathering-hero__pattern" aria-hidden="true"></div>
      </div>
    <% end %>

    <div class="event-gathering-hero__content p-6">
      <nav aria-label="Breadcrumbs" class="event-breadcrumbs mb-3 fs-s color-base-60">
        <a href="<%= events_path %>" class="c-link c-link--branded font-bold"><%= t("views.events.gathering.events") %></a>
        <span aria-hidden="true">&gt;</span>
        <a href="<%= type_landing_path %>" class="c-link c-link--branded font-bold"><%= t("views.events.gathering.#{type_key}") %></a>
        <span aria-hidden="true">&gt;</span>
        <span><%= @event.title %></span>
      </nav>

      <div class="flex justify-between items-start flex-wrap gap-4">
        <div class="flex-1 min-w-0">
          <div class="flex flex-wrap items-center gap-2 mb-3">
            <span class="event-pill <%= event_pill_class(@event) %>"><%= @event.format_pill_label %></span>
            <% if @event.start_time > now %>
              <span class="event-status-badge event-status-badge--upcoming-subtle"><%= t("views.events.gathering.upcoming") %></span>
            <% elsif @event.end_time >= now %>
              <span class="live-indicator event-status-badge event-status-badge--live">
                <span class="event-status-badge__dot" aria-hidden="true"></span>
                <%= t("views.events.gathering.live") %>
              </span>
            <% else %>
              <span class="event-status-badge event-status-badge--ended"><%= t("views.events.gathering.ended") %></span>
            <% end %>
            <% if schedule&.any? %>
              <a href="#event-schedule" class="event-schedule__count-pill event-schedule__count-pill--link">
                <%= t("views.events.hierarchy.sessions_count", count: schedule.total_count) %>
              </a>
            <% end %>
            <% if schedule&.live? %>
              <span class="event-status-badge event-status-badge--live">
                <span class="event-status-badge__dot" aria-hidden="true"></span>
                <%= t("views.events.hierarchy.live_count", count: schedule.live_count) %>
              </span>
            <% end %>
          </div>

          <h1 class="crayons-title text-3xl font-extrabold m-0"><%= @event.title %></h1>

          <% if @event.description.present? %>
            <p class="event-stage-header__lead mt-2 mb-0"><%= @event.description %></p>
          <% end %>

          <div class="event-stage-header__meta mt-4">
            <span class="event-meta-chip">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                <line x1="16" y1="2" x2="16" y2="6"></line>
                <line x1="8" y1="2" x2="8" y2="6"></line>
                <line x1="3" y1="10" x2="21" y2="10"></line>
              </svg>
              <%= event_datetime_range(@event) %>
            </span>
            <span class="event-meta-chip">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                <circle cx="12" cy="10" r="3"></circle>
              </svg>
              <%= @event.location_display %>
            </span>
            <% if host.present? %>
              <span class="event-meta-chip">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                  <circle cx="9" cy="7" r="4"></circle>
                </svg>
                <%= host.name %>
              </span>
            <% end %>
          </div>
        </div>

        <div class="flex items-center flex-wrap gap-2">
          <% if @primary_tag %>
            <div data-tag-id="<%= @primary_tag.id %>" data-tag-name="<%= @primary_tag.name %>" id="tag-<%= @primary_tag.id %>" class="js-tag-card">
              <div id="tag-buttons-<%= @primary_tag.id %>">
                <button class="c-btn c-btn--primary js-follow-tag-button">
                  <%= t("views.tags.follow") %>
                </button>
              </div>
            </div>
          <% end %>

          <button type="button"
                  class="crayons-btn crayons-btn--outlined js-copy-event-link"
                  data-copy-url="<%= app_url(event_path(@event.event_name_slug, @event.event_variation_slug)) %>"
                  data-copied-text="<%= t("views.events.stream.link_copied") %>">
            <span data-copy-label><%= t("views.events.stream.share") %></span>
          </button>
        </div>
      </div>
    </div>
  </header>

  <%= render "event_tabs" %>

  <%= render "sub_events_hero", event: @event, schedule: schedule %>

  <div class="flex flex-col m:flex-row gap-6">
    <main class="flex-1 min-w-0" id="main-content">
      <% if @event.primary_stream_url.present? %>
        <div class="mb-6">
          <%= render "stream_player", event: @event %>
        </div>
      <% end %>

      <%= render "sub_events_schedule", event: @event, schedule: schedule %>

      <article class="crayons-card p-6 mb-6">
        <h2 class="event-section-label"><%= t("views.events.gathering.about_heading") %></h2>
        <div class="crayons-article__body text-styles text-lg">
          <%= @event.body_html %>
        </div>
      </article>
    </main>

    <aside class="w-100 m:w-25 shrink-0">
      <% if @event.end_time > now %>
        <div class="crayons-card p-5 mb-6 text-center event-cta-card">
          <h3 class="font-bold mb-2"><%= t("views.events.gathering.register_heading") %></h3>
          <p class="fs-s color-base-70 mb-4"><%= t("views.events.gathering.register_description") %></p>
          <%= render "signup_button", event: @event, extra_classes: "w-100 text-center justify-center" %>
          <a href="<%= event_google_calendar_url(@event) %>"
             target="_blank"
             rel="noopener noreferrer"
             class="crayons-btn crayons-btn--secondary w-100 text-center justify-center mt-2">
            <%= t("views.events.stream.add_to_calendar") %>
          </a>
        </div>
      <% end %>

      <div class="crayons-card p-5 mb-6">
        <h3 class="event-sidebar-heading"><%= t("views.events.gathering.details") %></h3>
        <ul class="event-details-list">
          <li>
            <span class="event-details-list__label"><%= t("views.events.gathering.dates") %></span>
            <span class="event-details-list__value"><%= event_datetime_range(@event) %></span>
          </li>
          <li>
            <span class="event-details-list__label"><%= t("views.events.gathering.location") %></span>
            <span class="event-details-list__value"><%= @event.location_display %></span>
          </li>
          <li>
            <span class="event-details-list__label"><%= t("views.events.gathering.format") %></span>
            <span class="event-details-list__value"><%= @event.format_pill_label %></span>
          </li>
          <% if host.present? %>
            <li>
              <span class="event-details-list__label"><%= t("views.events.gathering.host") %></span>
              <span class="event-details-list__value">
                <% if @event.organization %>
                  <a href="<%= organization_path(@event.organization) %>" class="c-link c-link--branded font-medium">
                    <%= @event.organization.name %>
                  </a>
                <% elsif @event.user %>
                  <a href="<%= user_path(@event.user) %>" class="c-link c-link--branded font-medium">
                    <%= @event.user.name %>
                  </a>
                <% end %>
              </span>
            </li>
          <% end %>
        </ul>

        <% if external_url.present? %>
          <div class="mt-4 pt-4 border-t">
            <a href="<%= external_url %>" target="_blank" rel="noopener noreferrer" class="crayons-btn crayons-btn--outlined w-100 text-center justify-center">
              <%= external_cta_label %>
            </a>
          </div>
        <% end %>
      </div>

      <% if @event_nav_pages.present? %>
        <div class="crayons-card p-5 mb-6">
          <h3 class="event-sidebar-heading"><%= t("views.events.gathering.explore_pages") %></h3>
          <nav class="event-subpages-list" aria-label="<%= t("views.events.gathering.explore_pages") %>">
            <% @event_nav_pages.each do |nav_page| %>
              <a href="<%= event_custom_page_path(@event.event_name_slug, @event.event_variation_slug, event_page_suffix(nav_page)) %>"
                 class="event-subpages-list__item">
                <span><%= nav_page.title %></span>
                <span aria-hidden="true">→</span>
              </a>
            <% end %>
          </nav>
        </div>
      <% end %>
    </aside>
  </div>

  <%= render "event_articles", articles: @event_articles, event: @event, previews: @event_article_previews %>

  <%= render "community_articles", articles: @articles, tag_name: @tag_name %>

  <%= render "local_time_script" %>
</div>

<% if @primary_tag %>
  <%= javascript_include_tag "tagFollows", defer: true %>
<% end %>
