#!/usr/bin/env ruby
require_relative "../lib/local_redis/cache"

socket = LocalRedis::Cache.socket_path(ENV.fetch("LOCAL_REDIS_URL"))
maxmemory = ENV.fetch("LOCAL_REDIS_MAXMEMORY", "128mb")
unless maxmemory.match?(/\A[1-9]\d*(?:kb|mb|gb)?\z/i)
  abort "LOCAL_REDIS_MAXMEMORY must be a positive byte count or a size such as 128mb"
end
exec "redis-server", "--port", "0", "--unixsocket", socket, "--unixsocketperm", "700",
     "--maxmemory", maxmemory, "--maxmemory-policy", "allkeys-lfu",
     "--save", "", "--appendonly", "no", "--daemonize", "no", "--loglevel", "warning"
