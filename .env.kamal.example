# Copy to `.env.kamal` (gitignored) and load before running Kamal:
#   cp .env.kamal.example .env.kamal
#   set -a && source .env.kamal && set +a
#   bundle exec kamal setup

# ==============================================================================
# 1. MINIMAL REQUIRED SETTINGS (Single Bare-Metal Server / DigitalOcean Droplet)
# ==============================================================================
KAMAL_HOST="203.0.113.10"
APP_DOMAIN="community.example.com"
# Generate with: openssl rand -hex 64
SECRET_KEY_BASE="replace-with-openssl-rand-hex-64"
# Local Postgres accessory password (avoid shell-special characters or quote safely)
POSTGRES_PASSWORD="replace-with-strong-password"

# ==============================================================================
# 2. OPTIONAL: MULTI-SERVER / SSH / BUILDER OVERRIDES
# ==============================================================================
# KAMAL_SERVICE="forem"
# KAMAL_SSH_USER="root"
# KAMAL_SSH_PORT="22"
# KAMAL_SSH_KEY="~/.ssh/id_ed25519"
# KAMAL_WEB_HOSTS="10.0.0.10,10.0.0.11"
# KAMAL_JOB_HOSTS="10.0.0.20"
# KAMAL_DB_IP="10.0.0.30"
# KAMAL_REDIS_IP="10.0.0.30"
# KAMAL_DB_PORT="127.0.0.1:5432:5432"
# KAMAL_REDIS_PORT="127.0.0.1:6379:6379"
# KAMAL_ARCH="amd64"
# KAMAL_REMOTE_BUILDER="ssh://root@builder.example.com"
# KAMAL_BUILDER_LOCAL="false"   # always use KAMAL_REMOTE_BUILDER, even when this machine matches KAMAL_ARCH

# ==============================================================================
# 3. OPTIONAL: EXTERNAL REGISTRY (Leave unset for Kamal's built-in localhost:5555)
# ==============================================================================
# KAMAL_REGISTRY_SERVER="ghcr.io"              # or registry.digitalocean.com / docker.io
# KAMAL_REGISTRY_USERNAME="your-username"
# KAMAL_REGISTRY_PASSWORD="your-registry-token"
# KAMAL_IMAGE="your-username/forem"

# ==============================================================================
# 4. OPTIONAL: MANAGED DATABASE & REDIS (`-d managed` or `-d cluster`)
# ==============================================================================
# Managed Postgres connection URI (with sslmode=require when required by your provider)
# DATABASE_URL="<your-managed-postgres-connection-uri>"
# REDIS_URL="rediss://default:pass@managed-redis.example.com:25061/1"
# REDIS_SIDEKIQ_URL="rediss://default:pass@managed-redis.example.com:25061/3"
# REDIS_SESSIONS_URL="rediss://default:pass@managed-redis.example.com:25061/4"
# REDIS_RPUSH_URL="rediss://default:pass@managed-redis.example.com:25061/5"

# ==============================================================================
# 5. OPTIONAL: S3 / DIGITALOCEAN SPACES / CLOUDFLARE R2 / MINIO OBJECT STORAGE
# ==============================================================================
# AWS_ID="your-access-key"
# AWS_SECRET="your-secret-key"
# AWS_BUCKET_NAME="your-bucket-name"
# AWS_UPLOAD_REGION="nyc3"                     # e.g. us-east-1 (AWS/R2: auto) or nyc3 (DO Spaces)
# AWS_ENDPOINT="https://nyc3.digitaloceanspaces.com"
# AWS_PATH_STYLE="false"                       # set "true" for MinIO or path-style S3 endpoints
# CARRIERWAVE_ASSET_HOST="https://your-bucket.nyc3.cdn.digitaloceanspaces.com"

# ==============================================================================
# 6. OPTIONAL: EMAIL / CONCURRENCY / EDGE / OBSERVABILITY
# ==============================================================================
# SMTP_ADDRESS="smtp.postmarkapp.com"
# SMTP_PORT="587"
# SMTP_USER_NAME="your-smtp-user"
# SMTP_PASSWORD="your-smtp-password"
# SMTP_DOMAIN="community.example.com"
# DEFAULT_EMAIL="hello@example.com"
# WEB_CONCURRENCY="2"
# RAILS_MAX_THREADS="5"
# SIDEKIQ_CONCURRENCY="10"
# LOCAL_REDIS_URL="redis://127.0.0.1:6380/0"
# FASTLY_API_KEY=""
# FASTLY_SERVICE_ID=""
# FASTLY_CDN_URL=""
